      "service": "mysql57",
      "container": "deltascope-ddl-golden-mysql57",
      "image": "mysql:5.7.44",
      "product": "mysql",
      "version_contains": "5.7.44",
      "database": "golden",
      "exec_client": [
        "mysql",
        "-uroot",
        "-proot"
      ],
      "needs_database_create": false
    },
