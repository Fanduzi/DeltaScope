  "policy": {
    "profiles": {
      "t13-drop": {
        "enable": {
          "ddl.alter.drop_partition.forbid": {
            "level": "blocker"
          }
        }
      },
      "t13-truncate": {
        "enable": {
          "ddl.alter.truncate_partition.forbid": {
            "level": "blocker"
          }
        }
      },
      "t13-exchange": {
        "enable": {
          "ddl.alter.exchange_partition.warn": {
            "level": "warning"
          }
        }
      },
      "t13-deny-x": {
        "enable": {
          "ddl.table.denylist.forbid": {
            "level": "blocker",
            "params": {
              "tables": [
                "t13x"
              ]
            }
          }
        }
      },
      "t13-deny-t": {
        "enable": {
          "ddl.table.denylist.forbid": {
            "level": "blocker",
            "params": {
              "tables": [
                "t"
              ]
            }
          }
        }
      }
    }
  },
