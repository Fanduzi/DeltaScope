{
  "task_id": "T13",
  "issue": "https://github.com/Fanduzi/DeltaScope/issues/92",
  "policy_profile": "all-rules-disabled",
  "description": "Frozen destructive/data-moving partition contract: DROP PARTITION / TRUNCATE PARTITION / EXCHANGE PARTITION are audited actions with frozen rule IDs (ddl.alter.drop_partition.forbid blocker, ddl.alter.truncate_partition.forbid blocker, ddl.alter.exchange_partition.warn warning), partition-name attribution, the exchanged-table identity entering TableTargets so protected-object rules see both sides, complete coverage on all four anchors, and ordered-state that keeps member facts while dropping data-derived statistics (multi-spec partition ALTER is a proven native refusal) — independent T13 acceptance contract",
  "anchors": {
    "mysql57": {
      "service": "mysql57",
      "container": "deltascope-ddl-golden-mysql57",
      "image": "mysql:5.7.44",
      "product": "mysql",
      "version_contains": "5.7.44",
      "database": "golden",
      "exec_client": [
        "mysql",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": false,
      "exec_password_env": "T13_MYSQL_PASSWORD"
    },
    "mysql80": {
      "service": "mysql80",
      "container": "deltascope-ddl-golden-mysql80",
      "image": "mysql:8.0.46",
      "product": "mysql",
      "version_contains": "8.0.46",
      "database": "golden",
      "exec_client": [
        "mysql",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": false,
      "exec_password_env": "T13_MYSQL_PASSWORD"
    },
    "mysql84": {
      "service": "mysql84",
      "container": "deltascope-ddl-golden-mysql84",
      "image": "mysql:8.4.10",
      "product": "mysql",
      "version_contains": "8.4.10",
      "database": "golden",
      "exec_client": [
        "mysql",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": false,
      "exec_password_env": "T13_MYSQL_PASSWORD"
    },
    "tidb85": {
      "service": "tidb85",
      "container": "deltascope-ddl-golden-tidb85",
      "client_container": "deltascope-ddl-golden-tidb85-client",
      "client_service": "tidb85-client",
      "image": "pingcap/tidb:v8.5.0",
      "product": "tidb",
      "version_contains": "v8.5.0",
      "database": "golden",
      "exec_client": [
        "mysql",
        "--protocol=tcp",
        "-h",
        "tidb85",
        "-P",
        "4000",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": true
    }
  },
  "ddl_steps": [
    {
      "name": "create-partitioned-fixture",
      "sql": "CREATE TABLE t13g (id INT, c INT) PARTITION BY RANGE (id) (PARTITION p0 VALUES LESS THAN (100), PARTITION p1 VALUES LESS THAN (200))",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "range fixture lands with two named partitions on every anchor",
          "sql": "SELECT COUNT(*) FROM information_schema.PARTITIONS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='t13g' AND PARTITION_NAME IS NOT NULL",
          "expect": "2"
        }
      ]
    },
    {
      "name": "seed-partition-rows",
      "sql": "INSERT INTO t13g VALUES (10, 1), (150, 2)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "the p1-range row lands",
          "sql": "SELECT COUNT(*) FROM golden.t13g WHERE id >= 100",
          "expect": "1"
        }
      ]
    },
    {
      "name": "drop-partition-p0",
      "sql": "ALTER TABLE t13g DROP PARTITION p0",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "p0 definition is gone after DROP PARTITION",
          "sql": "SELECT COUNT(*) FROM information_schema.PARTITIONS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='t13g' AND PARTITION_NAME='p0'",
          "expect": "0"
        },
        {
          "assert": "p1's row survives the drop",
          "sql": "SELECT COUNT(*) FROM golden.t13g WHERE id >= 100",
          "expect": "1"
        }
      ]
    },
    {
      "name": "truncate-partition-p1",
      "sql": "ALTER TABLE t13g TRUNCATE PARTITION p1",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "p1 definition survives TRUNCATE while its rows are gone",
          "sql": "SELECT COUNT(*) FROM information_schema.PARTITIONS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='t13g' AND PARTITION_NAME='p1'",
          "expect": "1"
        },
        {
          "assert": "no rows remain in the table after both partitions emptied",
          "sql": "SELECT COUNT(*) FROM golden.t13g",
          "expect": "0"
        }
      ]
    },
    {
      "name": "create-exchange-counterpart",
      "sql": "CREATE TABLE t13x (id INT, c INT)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "exchange counterpart is a plain non-partitioned table",
          "sql": "SELECT COUNT(*) FROM information_schema.PARTITIONS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='t13x' AND PARTITION_NAME IS NOT NULL",
          "expect": "0"
        }
      ]
    },
    {
      "name": "seed-exchange-row",
      "sql": "INSERT INTO t13x VALUES (160, 9)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "counterpart row lands inside p1 range (100 <= 160 < 200)",
          "sql": "SELECT COUNT(*) FROM golden.t13x",
          "expect": "1"
        }
      ]
    },
    {
      "name": "exchange-partition-p1",
      "sql": "ALTER TABLE t13g EXCHANGE PARTITION p1 WITH TABLE t13x WITHOUT VALIDATION",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "the counterpart row moved into the partitioned table",
          "sql": "SELECT COUNT(*) FROM golden.t13g",
          "expect": "1"
        },
        {
          "assert": "the counterpart is empty after the swap",
          "sql": "SELECT COUNT(*) FROM golden.t13x",
          "expect": "0"
        }
      ]
    },
    {
      "name": "cleanup",
      "sql": "DROP TABLE t13g, t13x",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "fixtures removed",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='golden' AND TABLE_NAME IN ('t13g','t13x')",
          "expect": "0"
        }
      ]
    }
  ],
  "syntax_negative": {
    "sql": "ALTER TABLE t13g DROP PARTITION (",
