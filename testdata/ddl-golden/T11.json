    "dialects": [
      "mysql",
      "tidb"
    ],
    "sql": "CREATE TABLE t (a INT);",
    "expect": {
      "exit": 0,
      "verdict": "pass",
      "statements": 1,
      "findings": 0,
      "diagnostics": 0,
      "unsupported": 0,
      "coverage": "complete"
    }
  },
  "policy": {
    "profiles": {
      "t11-fk-forbid": {
        "enable": {
          "ddl.table.foreign_key.forbid": {
            "level": "blocker",
            "params": {
              "forbid": true
            }
          }
        }
      },
      "t11-fk-name": {
        "enable": {
          "ddl.constraint.foreign_key.name.prefix.require": {
            "level": "warning",
            "params": {
              "prefix": "fk_"
            }
          }
        }
      },
      "t11-pk-max": {
        "enable": {
          "ddl.table.primary_key.columns.max_count": {
            "level": "blocker",
            "params": {
              "limit": 1
            }
          }
        }
      },
      "t11-pk-name": {
        "enable": {
          "ddl.constraint.primary_key.name.prefix.require": {
            "level": "warning",
            "params": {
              "prefix": "pk_"
            }
          }
        }
      },
      "t11-uk-name": {
        "enable": {
          "ddl.constraint.unique_key.name.prefix.require": {
            "level": "warning",
            "params": {
              "prefix": "uk_"
            }
          }
        }
      },
      "t11-fk-exists": {
        "enable": {
          "ddl.alter.drop_foreign_key.exists.require": {
            "level": "blocker"
          }
        }
      },
      "t11-fk-exists-notice": {
        "enable": {
          "ddl.alter.drop_foreign_key.exists.require": {
            "level": "blocker"
          },
          "ddl.alter.drop_foreign_key.notice": {
            "level": "notice"
          },
          "ddl.table.exists.alter.require": {
            "level": "blocker"
          }
        }
      },
      "t11-drop-index": {
        "enable": {
          "ddl.alter.drop_index.exists.require": {
            "level": "blocker"
          },
          "ddl.table.exists.alter.require": {
            "level": "blocker"
          }
        }
      },
      "t11-notice": {
        "enable": {
          "ddl.alter.add_constraint.notice": {
            "level": "notice"
          },
          "ddl.alter.drop_foreign_key.notice": {
            "level": "notice"
          }
        }
      },
      "t11-off": {
        "enable": {}
      }
    }
  },
