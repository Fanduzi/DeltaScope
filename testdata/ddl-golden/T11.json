{
  "task_id": "T11",
  "issue": "https://github.com/Fanduzi/DeltaScope/issues/90",
  "policy_profile": "all-rules-disabled",
  "description": "Frozen unified PK/UNIQUE/FK CREATE/ALTER contract: foreign-key forbid and naming rules judge ALTER add_constraint identically to CREATE table constraints, primary-key column-count parity, modeled ON DELETE/ON UPDATE referential actions (MATCH stays unmodeled evidence), a new ddl.alter.drop_foreign_key.exists.require member rule over the constraint collection, provider-loaded foreign-key constraints, and ordered-state constraint/supporting-index semantics \u2014 independent T11 acceptance contract",
  "anchors": {
    "mysql57": {
      "service": "mysql57",
      "container": "deltascope-ddl-golden-mysql57",
      "image": "mysql:5.7.44",
      "product": "mysql",
      "version_contains": "5.7.44",
      "database": "golden",
      "exec_client": [
        "mysql",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": false,
      "exec_password_env": "T11_MYSQL_PASSWORD"
    },
    "mysql80": {
      "service": "mysql80",
      "container": "deltascope-ddl-golden-mysql80",
      "image": "mysql:8.0.46",
      "product": "mysql",
      "version_contains": "8.0.46",
      "database": "golden",
      "exec_client": [
        "mysql",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": false,
      "exec_password_env": "T11_MYSQL_PASSWORD"
    },
    "mysql84": {
      "service": "mysql84",
      "container": "deltascope-ddl-golden-mysql84",
      "image": "mysql:8.4.10",
      "product": "mysql",
      "version_contains": "8.4.10",
      "database": "golden",
      "exec_client": [
        "mysql",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": false,
      "exec_password_env": "T11_MYSQL_PASSWORD"
    },
    "tidb85": {
      "service": "tidb85",
      "container": "deltascope-ddl-golden-tidb85",
      "client_container": "deltascope-ddl-golden-tidb85-client",
      "client_service": "tidb85-client",
      "image": "pingcap/tidb:v8.5.0",
      "product": "tidb",
      "version_contains": "v8.5.0",
      "database": "golden",
      "exec_client": [
        "mysql",
        "--protocol=tcp",
        "-h",
        "tidb85",
        "-P",
        "4000",
        "-uroot",
        "--default-character-set=utf8mb4"
      ],
      "needs_database_create": true
    }
  },
  "ddl_steps": [
    {
      "name": "create-parent",
      "sql": "CREATE TABLE golden_p (id INT PRIMARY KEY)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "parent table exists",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_p'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "create-child",
      "sql": "CREATE TABLE golden_c (a INT, b INT, x INT)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "child table exists",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "add-named-fk",
      "sql": "ALTER TABLE golden_c ADD CONSTRAINT fk_a FOREIGN KEY (a) REFERENCES golden_p(id)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "fk constraint row exists",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLE_CONSTRAINTS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND CONSTRAINT_TYPE='FOREIGN KEY' AND CONSTRAINT_NAME='fk_a'",
          "expect": "1"
        },
        {
          "assert": "implicit supporting index named after constraint",
          "sql": "SELECT COUNT(DISTINCT INDEX_NAME) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND INDEX_NAME='fk_a'",
          "expect": "1"
        },
        {
          "assert": "ordered local and referenced columns",
          "sql": "SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND CONSTRAINT_NAME='fk_a' AND COLUMN_NAME='a' AND REFERENCED_TABLE_NAME='golden_p' AND REFERENCED_COLUMN_NAME='id'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "create-ref-composite",
      "sql": "CREATE TABLE golden_r (y INT, z INT, PRIMARY KEY (y, z))",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "composite ref table exists",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_r'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "add-composite-fk-actions",
      "sql": "ALTER TABLE golden_c ADD CONSTRAINT fk_bx FOREIGN KEY (b, x) REFERENCES golden_r (y, z) ON DELETE SET NULL ON UPDATE CASCADE",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "composite key parts keep ordinal order",
          "sql": "SELECT GROUP_CONCAT(CONCAT(COLUMN_NAME, '->', REFERENCED_COLUMN_NAME) ORDER BY ORDINAL_POSITION) FROM information_schema.KEY_COLUMN_USAGE WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND CONSTRAINT_NAME='fk_bx'",
          "expect": "b->y,x->z"
        },
        {
          "assert": "referential actions recorded in catalog",
          "sql": "SELECT CONCAT(DELETE_RULE, '/', UPDATE_RULE) FROM information_schema.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_SCHEMA='golden' AND TABLE_NAME='golden_c' AND CONSTRAINT_NAME='fk_bx'",
          "expect": "SET NULL/CASCADE"
        }
      ]
    },
    {
      "name": "create-child-bare",
      "sql": "CREATE TABLE golden_c2 (q INT)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "bare-fk child exists",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c2'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "add-bare-fk-derived-name",
      "sql": "ALTER TABLE golden_c2 ADD FOREIGN KEY (q) REFERENCES golden_p(id)",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "exactly one fk constraint lands",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLE_CONSTRAINTS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c2' AND CONSTRAINT_TYPE='FOREIGN KEY'",
          "expect": "1"
        },
        {
          "assert": "one supporting index exists",
          "sql": "SELECT COUNT(DISTINCT INDEX_NAME) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c2'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "dup-fk-name-refused",
      "sql": "ALTER TABLE golden_c ADD CONSTRAINT fk_a FOREIGN KEY (x) REFERENCES golden_p(id)",
      "expect_rc": 1,
      "verify": [
        {
          "assert": "constraint count unchanged by refused duplicate",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLE_CONSTRAINTS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND CONSTRAINT_TYPE='FOREIGN KEY'",
          "expect": "2"
        }
      ]
    },
    {
      "name": "add-fk-missing-column-refused",
      "sql": "ALTER TABLE golden_c ADD CONSTRAINT fk_missing FOREIGN KEY (no_such_col) REFERENCES golden_p(id)",
      "expect_rc": 1,
      "verify": [
        {
          "assert": "no fk added on missing column",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLE_CONSTRAINTS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND CONSTRAINT_NAME='fk_missing'",
          "expect": "0"
        }
      ]
    },
    {
      "name": "drop-fk-keeps-index",
      "sql": "ALTER TABLE golden_c DROP FOREIGN KEY fk_a",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "constraint removed",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLE_CONSTRAINTS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND CONSTRAINT_NAME='fk_a'",
          "expect": "0"
        },
        {
          "assert": "supporting index survives constraint drop",
          "sql": "SELECT COUNT(DISTINCT INDEX_NAME) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND INDEX_NAME='fk_a'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "drop-needed-index-refused",
      "sql": "ALTER TABLE golden_c DROP INDEX fk_bx",
      "expect_rc": 1,
      "verify": [
        {
          "assert": "needed index survives refused drop",
          "sql": "SELECT COUNT(DISTINCT INDEX_NAME) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA='golden' AND TABLE_NAME='golden_c' AND INDEX_NAME='fk_bx'",
          "expect": "1"
        }
      ]
    },
    {
      "name": "drop-fixtures",
      "sql": "DROP TABLE golden_c, golden_c2, golden_r, golden_p",
      "expect_rc": 0,
      "verify": [
        {
          "assert": "fixtures dropped",
          "sql": "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='golden' AND TABLE_NAME IN ('golden_c','golden_c2','golden_r','golden_p')",
          "expect": "0"
        }
      ]
    }
  ],
  "syntax_negative": {
    "sql": "ALTER TABLE golden_c ADD CONSTRAINT FOREIGN KEY (",
    "expect": {
      "rc_nonzero": true,
      "error_class": "1064",
      "forbidden_markers": [
        "ERROR 1045",
        "ERROR 1044",
        "ERROR 1049",
        "ERROR 1142",
        "ERROR 1143",
        "ERROR 2002",
        "ERROR 2003",
        "ERROR 2005",
        "Access denied",
        "Unknown database",
        "Can't connect",
        "Connection refused",
        "already exists"
      ]
    }
  },
