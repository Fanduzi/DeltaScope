{
 "task_id": "T15",
 "issue": "https://github.com/Fanduzi/DeltaScope/issues/94",
 "policy_profile": "all-rules-disabled",
 "description": "Frozen table-option / charset-conversion / online-DDL contract (#94): ALGORITHM=/LOCK= modifiers are audited actions adjudicated by the probed per-dialect matrix (MySQL 1800/1845/1846/1221 refusal classes, TiDB per-operation acceptance plus the probed add_index INSTANT refusal). Table options publish catalog-mapped effects, TiDB vendor refusals stay bounded aspects, CONVERT TO rewrites string columns, and long-tail option names extract into bounded evidence — never silently accepted.",
 "anchors": {
  "mysql57": {
   "service": "mysql57",
   "container": "deltascope-ddl-golden-mysql57",
   "image": "mysql:5.7.44",
   "product": "mysql",
   "version_contains": "5.7.44",
   "database": "golden",
   "exec_client": [
    "mysql",
    "-uroot",
    "--default-character-set=utf8mb4"
   ],
   "needs_database_create": false,
   "exec_password_env": "T15_MYSQL_PASSWORD"
  },
  "mysql80": {
