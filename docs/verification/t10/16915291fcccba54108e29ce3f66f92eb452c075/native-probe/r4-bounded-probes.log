=== M9 tidb85 clustered DROP PRIMARY KEY executability (R4-C) ===

=== M9a mode=on int PK (PKIsHandle control): CLUSTERED=yes row, drop refused 8200, ALTER PRIMARY reports 1176 (no object) ===
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e "SET GLOBAL tidb_enable_clustered_index='on';"
rc=0
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e 'DROP TABLE IF EXISTS golden.t10r4_c1; CREATE TABLE golden.t10r4_c1(id INT PRIMARY KEY, c INT);'
rc=0
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e 'SELECT KEY_NAME,CLUSTERED FROM information_schema.TIDB_INDEXES WHERE table_schema="golden" AND table_name="t10r4_c1";'
KEY_NAME	CLUSTERED
PRIMARY	YES
rc=0
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e 'ALTER TABLE golden.t10r4_c1 DROP PRIMARY KEY;'
ERROR 8200 (HY000) at line 1: Unsupported drop primary key when the table is using clustered index
rc=1
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e 'ALTER TABLE golden.t10r4_c1 ALTER INDEX `PRIMARY` VISIBLE;'
ERROR 1176 (42000) at line 1: Key 'PRIMARY' doesn't exist in table 't10r4_c1'
rc=1

