=== M4 explicit PK frees later UNIQUE INVISIBLE (mysql80) ===
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'DROP TABLE IF EXISTS golden.t10r3_pk; CREATE TABLE golden.t10r3_pk(id INT PRIMARY KEY, c INT);'
rc=0
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'ALTER TABLE golden.t10r3_pk ADD UNIQUE (c) INVISIBLE;'
rc=0
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'SHOW INDEX FROM golden.t10r3_pk;'
