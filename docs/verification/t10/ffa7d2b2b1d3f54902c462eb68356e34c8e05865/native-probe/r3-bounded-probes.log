=== M1 fulltext prefix length (mysql80) ===
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'DROP TABLE IF EXISTS golden.t10r3_ft; CREATE TABLE golden.t10r3_ft(c TEXT);'
rc=0
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'CREATE FULLTEXT INDEX ft5 ON golden.t10r3_ft(c(5));'
rc=0
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'CREATE FULLTEXT INDEX ft0 ON golden.t10r3_ft(c(0));'
ERROR 1391 (HY000) at line 1: Key part 'c' length cannot be 0
rc=1

=== M2 multi-valued cast dialect matrix (mysql80 then tidb85) ===
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'DROP TABLE IF EXISTS golden.t10r3_mv; CREATE TABLE golden.t10r3_mv(j JSON);'
rc=0
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'CREATE INDEX mvd ON golden.t10r3_mv((CAST(j AS DECIMAL(10,2) ARRAY)));'
rc=0
$ docker exec --env MYSQL_PWD=root deltascope-ddl-golden-mysql80 mysql -uroot -e 'CREATE INDEX mvdbl ON golden.t10r3_mv((CAST(j AS DOUBLE ARRAY)));'
ERROR 1235 (42000) at line 1: This version of MySQL doesn't yet support 'CAST-ing data to array of DOUBLE'
rc=1
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e 'DROP TABLE IF EXISTS golden.t10r3_mv; CREATE TABLE golden.t10r3_mv(j JSON);'
rc=0
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e 'CREATE INDEX mvd ON golden.t10r3_mv((CAST(j AS DECIMAL(10,2) ARRAY)));'
ERROR 1235 (42000) at line 1: This version of TiDB doesn't yet support 'CAST-ing data to array of decimal(10,2) BINARY'
rc=1
$ docker exec deltascope-ddl-golden-tidb85-client mysql -h tidb85 -P4000 -uroot -e 'CREATE INDEX mvdbl ON golden.t10r3_mv((CAST(j AS DOUBLE ARRAY)));'
rc=0

=== M3 tidb clustered defaults + alter-primary-key + int_only handle (tidb85) ===
