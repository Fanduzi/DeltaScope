+func TestT17R1TailExplicitCollationAndNoop(t *testing.T) {
+	version, err := parseAuditTargetVersion(spec.DialectMySQL, "8.0.46")
+	if err != nil {
+		t.Fatal(err)
+	}
+	facts := &spec.InstanceFacts{DefaultCollationForUTF8MB4: "utf8mb4_general_ci"}
+	p := &t17ObjectResolver{answer: t17TailFixture(false), facts: facts}
+	_, statements := t17Enrich(t, spec.DialectMySQL, "CREATE DATABASE g COLLATE utf8mb4_bin; ALTER DATABASE g CHARACTER SET latin1;", "req", version, p)
+	want := map[string]string{"charset": "utf8mb4", "collation": "utf8mb4_bin"}
+	if target := statements[1].MetadataSchemaTarget(); target == nil || !reflect.DeepEqual(target.Attributes, want) {
+		t.Fatalf("explicit collation projection=%#v", target)
+	}
+	original := &spec.ObjectSnapshot{Status: spec.MetadataStatusConfirmed, Exists: true, Attributes: map[string]string{"charset": "latin1", "collation": "latin1_swedish_ci", "encryption": "yes", "placement_policy": "old"}}
+	p = &t17ObjectResolver{answer: original, facts: facts}
+	state, statements := t17Enrich(t, spec.DialectMySQL, "CREATE DATABASE IF NOT EXISTS g CHARACTER SET utf8mb4; ALTER DATABASE g COLLATE utf8mb4_bin;", "req", version, p)
+	wantOriginal := map[string]string{"charset": "latin1", "collation": "latin1_swedish_ci", "encryption": "yes", "placement_policy": "old"}
+	if target := statements[1].MetadataSchemaTarget(); target == nil || !reflect.DeepEqual(target.Attributes, wantOriginal) {
+		t.Errorf("noop projection=%#v", target)
+	}
+	if !reflect.DeepEqual(original.Attributes, wantOriginal) || state.schemaEntries["g"].batchCreated {
+		t.Errorf("provider=%#v entry=%#v", original, state.schemaEntries["g"])
+	}
+}
