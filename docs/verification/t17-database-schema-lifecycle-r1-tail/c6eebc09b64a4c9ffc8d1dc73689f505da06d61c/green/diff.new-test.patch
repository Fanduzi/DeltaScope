+func TestT17R1TailCharsetMatrix(t *testing.T) {
+	cases := []struct {
+		name, version, observed, want string
+		dialect, versionDialect       spec.Dialect
+	}{
+		{"mysql57", "5.7.44", "", "utf8mb4_general_ci", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql80-observed", "8.0.46", "utf8mb4_0900_ai_ci", "utf8mb4_0900_ai_ci", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql84-observed", "8.4.10", "utf8mb4_0900_ai_ci", "utf8mb4_0900_ai_ci", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql80-configured-general", "8.0.46", " UTF8MB4_GENERAL_CI ", "utf8mb4_general_ci", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql80-unobserved", "8.0.46", "", "", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql-unversioned", "", "", "", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql-future", "9.0.0", "", "", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql-unversioned-observed", "", "utf8mb4_general_ci", "utf8mb4_general_ci", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql-invalid-observation", "8.0.46", "latin1_bin", "", spec.DialectMySQL, spec.DialectMySQL},
+		{"mysql-foreign-product", "5.7.44", "", "", spec.DialectMySQL, spec.DialectTiDB},
+		{"tidb85", "8.5.0", "", "utf8mb4_bin", spec.DialectTiDB, spec.DialectTiDB},
+		{"tidb-unversioned", "", "", "", spec.DialectTiDB, spec.DialectTiDB},
+		{"tidb-future", "9.0.0", "", "", spec.DialectTiDB, spec.DialectTiDB},
+	}
+	for _, tc := range cases {
+		for _, present := range []bool{false, true} {
+			operation := "create"
+			sql := t17TailCreateSQL
+			if present {
+				operation, sql = "alter", t17TailAlterSQL
+			}
+			t.Run(tc.name+"/"+operation, func(t *testing.T) {
+				version, err := parseAuditTargetVersion(tc.versionDialect, tc.version)
+				if err != nil {
+					t.Fatal(err)
+				}
+				original := t17TailFixture(present)
+				if present {
+					original.Attributes["encryption"] = "yes"
+					original.Attributes["placement_policy"] = "old"
+				}
+				answer := t17TailFixture(present)
+				if present {
+					answer.Attributes["encryption"] = "yes"
+					answer.Attributes["placement_policy"] = "old"
+				}
+				facts := &spec.InstanceFacts{DefaultCollationForUTF8MB4: tc.observed}
+				if tc.name == "mysql80-configured-general" {
+					facts.ServerCollation = "utf8mb4_0900_ai_ci"
+				}
+				beforeFacts := *facts
+				p := &t17ObjectResolver{answer: answer, facts: facts}
+				state, statements := t17Enrich(t, tc.dialect, sql, "req", version, p)
+				first := t17TailFixture(present)
+				first.Schema, first.Type, first.Name = "g", "schema", "g"
+				if present {
+					first.Attributes["encryption"] = "yes"
+					first.Attributes["placement_policy"] = "old"
+				}
+				if got := statements[0].MetadataSchemaTarget(); !reflect.DeepEqual(got, first) {
+					t.Errorf("first projection=%#v want=%#v", got, first)
+				}
+				wantAttrs := map[string]string{"charset": "utf8mb4"}
+				if tc.want != "" {
+					wantAttrs["collation"] = tc.want
+				}
+				if present {
+					wantAttrs["encryption"] = "yes"
+					wantAttrs["placement_policy"] = "old"
+				}
+				want := &spec.ObjectSnapshot{Schema: "g", Type: "schema", Name: "g", Status: spec.MetadataStatusConfirmed, Exists: true, Attributes: wantAttrs}
+				if got := statements[1].MetadataSchemaTarget(); !reflect.DeepEqual(got, want) {
+					t.Errorf("second projection=%#v want=%#v", got, want)
+				}
+				finalAttrs := map[string]string{"charset": "utf8mb4", "collation": "utf8mb4_bin"}
+				if present {
+					finalAttrs["encryption"], finalAttrs["placement_policy"] = "yes", "old"
+				}
+				if entry := state.schemaEntries["g"]; entry == nil || entry.state != schemaPresent || entry.batchCreated != !present || !reflect.DeepEqual(entry.attrs, finalAttrs) {
+					t.Errorf("final entry=%#v", entry)
+				}
+				if !reflect.DeepEqual(answer, original) || *facts != beforeFacts || p.calls != 1 {
+					t.Errorf("fixture mutation or lookup count: answer=%#v facts=%#v calls=%d", answer, facts, p.calls)
+				}
+			})
+		}
+	}
+}
