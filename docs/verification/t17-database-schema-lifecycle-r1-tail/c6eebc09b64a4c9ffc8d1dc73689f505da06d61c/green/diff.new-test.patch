+func TestT17R1TailPolicyIndependence(t *testing.T) {
+	sql := t17TailCreateSQL
+	facts := &spec.InstanceFacts{Version: "8.0.46", DefaultCollationForUTF8MB4: "utf8mb4_general_ci"}
+	version, err := parseAuditTargetVersion(spec.DialectMySQL, "8.0.46")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ name, path string }{{"enabled", ""}, {"disabled", t05PolicyPath(t, map[string]string{})}} {
+		t.Run(tc.name, func(t *testing.T) {
+			p := &t17ObjectResolver{answer: t17TailFixture(false), facts: facts}
+			_, statements := t17Enrich(t, spec.DialectMySQL, sql, "req", version, p)
+			if target := statements[1].MetadataSchemaTarget(); target == nil || !reflect.DeepEqual(target.Attributes, map[string]string{"charset": "utf8mb4", "collation": "utf8mb4_general_ci"}) {
+				t.Errorf("internal projection=%#v", target)
+			}
+			p = &t17ObjectResolver{answer: t17TailFixture(false), facts: facts}
+			result, err := AuditSQL(context.Background(), Request{SQL: sql, Dialect: spec.DialectMySQL, TargetVersion: "8.0.46", ConfigPath: tc.path, Metadata: &MetadataRequest{Schema: "req", Provider: p}})
+			if err != nil || len(result.Statements) != 2 || p.calls != 1 {
+				t.Fatalf("public audit=%#v err=%v calls=%d", result, err, p.calls)
+			}
+			for _, statement := range result.Statements {
+				for _, finding := range statement.Findings {
+					if finding.RuleID == "ddl.database.create.exists.forbid" || finding.RuleID == "ddl.database.alter.exists.require" {
+						t.Errorf("unexpected finding=%#v", finding)
+					}
+				}
+				for _, gap := range statement.EvidenceGaps {
+					if gap.RuleID == "ddl.database.create.exists.forbid" || gap.RuleID == "ddl.database.alter.exists.require" {
+						t.Errorf("unexpected gap=%#v", gap)
+					}
+				}
+			}
+		})
+	}
