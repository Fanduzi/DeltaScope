+func TestT17R1TailBareCreateDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		name, version string
+		dialect       spec.Dialect
+		facts         *spec.InstanceFacts
+		want          map[string]string
+	}{
+		{"observed", "8.0.46", spec.DialectMySQL, &spec.InstanceFacts{ServerCharset: " LATIN1 ", ServerCollation: " LATIN1_BIN "}, map[string]string{"charset": "latin1", "collation": "latin1_bin"}},
+		{"mysql57-none", "5.7.44", spec.DialectMySQL, nil, map[string]string{}},
+		{"mysql80-none", "8.0.46", spec.DialectMySQL, nil, map[string]string{}},
+		{"mysql84-none", "8.4.10", spec.DialectMySQL, nil, map[string]string{}},
+		{"tidb85-none", "8.5.0", spec.DialectTiDB, nil, map[string]string{}},
+		{"database-charset-only", "8.0.46", spec.DialectMySQL, &spec.InstanceFacts{DefaultCharset: "utf8mb4"}, map[string]string{}},
+		{"server-charset-only", "8.0.46", spec.DialectMySQL, &spec.InstanceFacts{ServerCharset: "latin1"}, map[string]string{"charset": "latin1"}},
+		{"server-collation-only", "8.0.46", spec.DialectMySQL, &spec.InstanceFacts{ServerCollation: "latin1_bin"}, map[string]string{"collation": "latin1_bin"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			version, err := parseAuditTargetVersion(tc.dialect, tc.version)
+			if err != nil {
+				t.Fatal(err)
+			}
+			p := &t17ObjectResolver{answer: t17TailFixture(false), facts: tc.facts}
+			state, statements := t17Enrich(t, tc.dialect, "CREATE DATABASE g; ALTER DATABASE g CHARACTER SET latin1;", "req", version, p)
+			target := statements[1].MetadataSchemaTarget()
+			want := &spec.ObjectSnapshot{Schema: "g", Type: "schema", Name: "g", Status: spec.MetadataStatusConfirmed, Exists: true, Attributes: tc.want}
+			if !reflect.DeepEqual(target, want) {
+				t.Errorf("projection=%#v want=%#v", target, want)
+			}
+			if entry := state.schemaEntries["g"]; entry == nil || entry.state != schemaPresent || !entry.batchCreated {
+				t.Errorf("entry=%#v", entry)
+			}
+			if p.calls != 1 {
+				t.Errorf("object calls=%d", p.calls)
+			}
+		})
+	}
+}
