+			result, err := t05A7Audit(t, tc.sql, tc.dialect, nil, t05A7Policy(t, nil), 0)
+			if !errors.Is(err, ErrUnsupportedStatement) {
+				t.Fatalf("expected ErrUnsupportedStatement, got %v", err)
