+type t05A7CancelOnCheck struct {
+	context.Context
+	cancel    context.CancelFunc
+	remaining int
+}
+
+func (c *t05A7CancelOnCheck) Err() error {
+	c.remaining--
+	if c.remaining == 0 {
+		c.cancel()
+	}
+	return c.Context.Err()
+}
