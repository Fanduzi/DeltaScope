+
+var columnNames = []string{
+	"d2", "d3", "d0", "dm", "dn", "f2", "f3", "f0", "fn",
+	"x2", "x4", "x0", "xn", "e_upper", "e_lower", "e_order",
+	"s_upper", "s_lower", "s_order", "e_escaped", "s_escaped", "i", "v", "u",
+}
+
+var columnFamilies = []string{
+	"decimal", "decimal", "decimal", "decimal", "decimal", "float", "float", "float", "float",
+	"double", "double", "double", "double", "enum", "enum", "enum",
+	"set", "set", "set", "enum", "set", "int", "varchar", "bigint",
+}
+
+var memberFacts = map[string][]string{
+	"e_upper":   {"Ready", "Closed"},
+	"e_lower":   {"ready", "closed"},
+	"e_order":   {"Closed", "Ready"},
+	"s_upper":   {"Read", "Write"},
+	"s_lower":   {"read", "write"},
+	"s_order":   {"Write", "Read"},
+	"e_escaped": {"", "A,B", "A)B", "O'Reilly"},
+	"s_escaped": {"Read", "A)B", "O'Reilly"},
+}
+
+type anchor struct {
+	Name    string
+	Port    string
+	Version string
+	Dialect spec.Dialect
+}
+
+func anchorFor(name string) (anchor, error) {
+	anchors := map[string]anchor{
+		"mysql57": {"mysql57", "23357", "5.7.44", spec.DialectMySQL},
+		"mysql80": {"mysql80", "23380", "8.0.46", spec.DialectMySQL},
+		"mysql84": {"mysql84", "23384", "8.4.10", spec.DialectMySQL},
+		"tidb85":  {"tidb85", "24000", "8.0.11-TiDB-v8.5.0", spec.DialectTiDB},
+	}
+	value, ok := anchors[name]
+	if !ok {
+		return anchor{}, fmt.Errorf("unknown anchor %q; expected mysql57, mysql80, mysql84, or tidb85", name)
+	}
+	return value, nil
+}
+
+type catalogRow struct {
+	ColumnName       string  `json:"column_name"`
+	OrdinalPosition  int     `json:"ordinal_position"`
+	DataType         string  `json:"data_type"`
+	ColumnType       string  `json:"column_type"`
+	ColumnTypeHex    string  `json:"column_type_hex"`
+	NumericPrecision *int64  `json:"numeric_precision"`
+	NumericScale     *int64  `json:"numeric_scale"`
+	CharacterSet     *string `json:"character_set_name"`
+	Collation        *string `json:"collation_name"`
+}
+
+type pair struct {
+	Column   string `json:"column"`
+	Catalog  string `json:"catalog_column_type"`
+	Provider string `json:"provider_type"`
+	Length   int    `json:"provider_length"`
+	Unsigned bool   `json:"provider_unsigned"`
+}
+
+func validateCatalog(ctx context.Context, rows []catalogRow) error {
+	if len(rows) != len(columnNames) {
+		return fmt.Errorf("catalog column count=%d, want %d", len(rows), len(columnNames))
+	}
+	seen := make(map[string]bool, len(rows))
+	for i, row := range rows {
+		if seen[row.ColumnName] {
+			return fmt.Errorf("duplicate catalog column %q", row.ColumnName)
+		}
+		seen[row.ColumnName] = true
+		if row.ColumnName != columnNames[i] || row.OrdinalPosition != i+1 {
+			return fmt.Errorf("catalog position %d: name=%q ordinal=%d, want %q/%d", i, row.ColumnName, row.OrdinalPosition, columnNames[i], i+1)
+		}
+		if row.DataType != columnFamilies[i] {
+			return fmt.Errorf("catalog %s DATA_TYPE=%q, want %q", row.ColumnName, row.DataType, columnFamilies[i])
+		}
+		decoded, err := hex.DecodeString(row.ColumnTypeHex)
+		if err != nil || !bytes.Equal(decoded, []byte(row.ColumnType)) {
+			return fmt.Errorf("catalog %s COLUMN_TYPE/HEX mismatch", row.ColumnName)
+		}
+		if i < 3 {
+			wantScale := []int64{2, 3, 0}[i]
+			if row.NumericPrecision == nil || row.NumericScale == nil || *row.NumericPrecision != 12 || *row.NumericScale != wantScale {
+				return fmt.Errorf("catalog %s requires effective precision=12 scale=%d", row.ColumnName, wantScale)
+			}
+		}
+		if wantMembers, ok := memberFacts[row.ColumnName]; ok {
+			parsed, err := tidbparser.New().Parse(ctx, "CREATE TABLE member_fact (c "+row.ColumnType+")")
+			if err != nil {
+				return fmt.Errorf("catalog %s member decoding: %w", row.ColumnName, err)
+			}
+			if len(parsed.Statements) != 1 {
+				return fmt.Errorf("catalog %s member definition statement count=%d", row.ColumnName, len(parsed.Statements))
+			}
+			create, ok := parsed.Statements[0].(*ast.CreateTableStmt)
+			if !ok || len(create.Cols) != 1 || create.Cols[0].Tp == nil {
+				return fmt.Errorf("catalog %s member definition is not one typed column", row.ColumnName)
+			}
+			if got := create.Cols[0].Tp.GetElems(); !slices.Equal(got, wantMembers) {
+				return fmt.Errorf("catalog %s members=%q, want %q", row.ColumnName, got, wantMembers)
+			}
+		}
+		if _, members := memberFacts[row.ColumnName]; members || row.ColumnName == "v" {
+			if row.CharacterSet == nil || row.Collation == nil || *row.CharacterSet != "utf8mb4" || *row.Collation != "utf8mb4_bin" {
+				return fmt.Errorf("catalog %s requires utf8mb4/utf8mb4_bin", row.ColumnName)
+			}
+		}
+	}
+	return nil
+}
+
+func pairCatalogProvider(rows []catalogRow, snapshot *spec.TableSnapshot, target anchor) ([]pair, error) {
+	if snapshot == nil || !snapshot.Exists || snapshot.Table == nil {
+		return nil, fmt.Errorf("provider snapshot missing or not present")
+	}
+	if snapshot.Schema != "golden" || snapshot.Table.Name != "t06_a17_type_facts" {
+		return nil, fmt.Errorf("provider table identity mismatch: %s/%s", snapshot.Schema, snapshot.Table.Name)
+	}
+	if len(rows) != len(columnNames) || len(snapshot.Columns) != len(columnNames) {
+		return nil, fmt.Errorf("pairing column counts: catalog=%d provider=%d, want %d each", len(rows), len(snapshot.Columns), len(columnNames))
+	}
+	if snapshot.Options["engine"] != "InnoDB" || snapshot.Options["charset"] != "utf8mb4" || snapshot.Options["collation"] != "utf8mb4_bin" {
+		return nil, fmt.Errorf("provider table engine/charset/collation mismatch")
+	}
+	if snapshot.PrimaryKey != nil || len(snapshot.Indexes) != 0 {
+		return nil, fmt.Errorf("provider returned an undeclared primary key or index")
+	}
+	pairs := make([]pair, 0, len(columnNames))
+	seen := make(map[string]bool, len(columnNames))
+	for i, name := range columnNames {
+		column := snapshot.Columns[i]
+		if seen[column.Name] {
+			return nil, fmt.Errorf("duplicate provider column %q", column.Name)
+		}
+		seen[column.Name] = true
+		if rows[i].ColumnName != name || column.Name != name {
+			return nil, fmt.Errorf("pairing position %d: catalog=%q provider=%q, want %q", i, rows[i].ColumnName, column.Name, name)
+		}
+		if i < 21 {
+			if column.Type != rows[i].ColumnType || column.Unsigned {
+				return nil, fmt.Errorf("provider %s Type=%q unsigned=%v, catalog=%q unsigned=false", name, column.Type, column.Unsigned, rows[i].ColumnType)
+			}
+		} else {
+			wantLength := 0
+			if name == "v" {
+				wantLength = 8
+			} else if target.Name == "mysql57" {
+				if name == "i" {
+					wantLength = 11
+				} else {
+					wantLength = 20
+				}
+			}
+			if column.Type != columnFamilies[i] || column.Length != wantLength || column.Unsigned != (name == "u") {
+				return nil, fmt.Errorf("provider control %s=%q/%d/%v, want %q/%d/%v", name, column.Type, column.Length, column.Unsigned, columnFamilies[i], wantLength, name == "u")
+			}
+		}
+		pairs = append(pairs, pair{name, rows[i].ColumnType, column.Type, column.Length, column.Unsigned})
+	}
+	return pairs, nil
+}
+
+func validateSession(session map[string]string, target anchor) error {
+	if session["version"] != target.Version {
+		return fmt.Errorf("anchor %s VERSION()=%q, want %q", target.Name, session["version"], target.Version)
+	}
+	for _, name := range []string{"character_set_client", "character_set_connection", "character_set_results", "collation_connection"} {
+		if strings.TrimSpace(session[name]) == "" {
+			return fmt.Errorf("missing session fact %s", name)
+		}
+	}
+	if _, ok := session["sql_mode"]; !ok {
+		return fmt.Errorf("missing session sql_mode")
+	}
+	return nil
+}
diff --git a/scripts/t06a17proof/main.go b/scripts/t06a17proof/main.go
new file mode 100644
index 00000000..351a648f
--- /dev/null
+++ b/scripts/t06a17proof/main.go
@@ -0,0 +1,350 @@
+// Package main collects the bounded T06-A17-R1 native catalog/provider proof.
+// input: one of four pinned loopback anchors, environment-only credentials, and a new evidence directory
+// output: complete raw observations, query ledgers, strict pairs, and owned-table cleanup results; any failure is nonzero
+// pos: task-specific proof command outside the product audit and Golden runner
+// note: if this file changes, update this header and module README.md.
+package main
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	mysqlmeta "github.com/Fanduzi/DeltaScope/internal/infrastructure/metadata/mysql"
+	gomysql "github.com/go-sql-driver/mysql"
+)
+
+const countSQL = "select count(*) from information_schema.tables where table_schema='golden' and table_name='t06_a17_type_facts'"
+const catalogSQL = "select column_name, ordinal_position, data_type, column_type, hex(column_type), numeric_precision, numeric_scale, character_set_name, collation_name from information_schema.columns where table_schema='golden' and table_name='t06_a17_type_facts' order by ordinal_position"
+const dropSQL = "DROP TABLE golden.t06_a17_type_facts"
+
+var sessionQueries = []struct{ name, query string }{
+	{"version", "select version()"},
+	{"character_set_client", "select @@character_set_client"},
+	{"character_set_connection", "select @@character_set_connection"},
+	{"character_set_results", "select @@character_set_results"},
+	{"collation_connection", "select @@collation_connection"},
+	{"sql_mode", "select @@sql_mode"},
+}
+
+type ledgerEntry struct {
+	Op    string `json:"op"`
+	Query string `json:"query"`
+}
+
+type queryLedger struct {
+	mu      sync.Mutex
+	entries []ledgerEntry
+}
+
+func (l *queryLedger) add(op, query string) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.entries = append(l.entries, ledgerEntry{op, query})
+}
+
+func (l *queryLedger) snapshot() []ledgerEntry {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return append([]ledgerEntry(nil), l.entries...)
+}
+
+type ledgerConnector struct {
+	inner  driver.Connector
+	ledger *queryLedger
+}
+
+func (c *ledgerConnector) Connect(ctx context.Context) (driver.Conn, error) {
+	conn, err := c.inner.Connect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return &ledgerConn{conn, c.ledger}, nil
+}
+
+func (c *ledgerConnector) Driver() driver.Driver { return c.inner.Driver() }
+
+type ledgerConn struct {
+	conn   driver.Conn
+	ledger *queryLedger
+}
+
+func (c *ledgerConn) Prepare(query string) (driver.Stmt, error) {
+	stmt, err := c.conn.Prepare(query)
+	if err != nil {
+		return nil, err
+	}
+	return &ledgerStmt{stmt, query, c.ledger}, nil
+}
+
+func (c *ledgerConn) Close() error              { return c.conn.Close() }
+func (c *ledgerConn) Begin() (driver.Tx, error) { return c.conn.Begin() }
+
+func (c *ledgerConn) Ping(ctx context.Context) error {
+	if pinger, ok := c.conn.(driver.Pinger); ok {
+		return pinger.Ping(ctx)
+	}
+	return nil
+}
+
+func (c *ledgerConn) QueryContext(ctx context.Context, query string, args []driver.NamedValue) (driver.Rows, error) {
+	c.ledger.add("query", query)
+	if querier, ok := c.conn.(driver.QueryerContext); ok {
+		return querier.QueryContext(ctx, query, args)
+	}
+	return nil, driver.ErrSkip
+}
+
+func (c *ledgerConn) ExecContext(ctx context.Context, query string, args []driver.NamedValue) (driver.Result, error) {
+	c.ledger.add("exec", query)
+	if execer, ok := c.conn.(driver.ExecerContext); ok {
+		return execer.ExecContext(ctx, query, args)
+	}
+	return nil, driver.ErrSkip
+}
+
+type ledgerStmt struct {
+	stmt   driver.Stmt
+	query  string
+	ledger *queryLedger
+}
+
+func (s *ledgerStmt) Close() error  { return s.stmt.Close() }
+func (s *ledgerStmt) NumInput() int { return s.stmt.NumInput() }
+func (s *ledgerStmt) Exec(args []driver.Value) (driver.Result, error) {
+	s.ledger.add("stmt-exec", s.query)
+	return s.stmt.Exec(args)
+}
+func (s *ledgerStmt) Query(args []driver.Value) (driver.Rows, error) {
+	s.ledger.add("stmt-query", s.query)
+	return s.stmt.Query(args)
+}
+
+type evidenceWriter func(string, []byte) error
+
+func writeJSON(write evidenceWriter, name string, value any) error {
+	data, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encode %s: %w", name, err)
+	}
+	if err := write(name, append(data, '\n')); err != nil {
+		return fmt.Errorf("write %s: %w", name, err)
+	}
+	return nil
+}
+
+func tableCount(ctx context.Context, db *sql.DB) (int, error) {
+	var count int
+	if err := db.QueryRowContext(ctx, countSQL).Scan(&count); err != nil {
+		return 0, fmt.Errorf("table COUNT query/scan: %w", err)
+	}
+	return count, nil
+}
+
+func readCatalog(ctx context.Context, db *sql.DB) (result []catalogRow, err error) {
+	rows, err := db.QueryContext(ctx, catalogSQL)
+	if err != nil {
+		return nil, fmt.Errorf("query catalog: %w", err)
+	}
+	defer func() { err = errors.Join(err, rows.Close()) }()
+	for rows.Next() {
+		var row catalogRow
+		var precision, scale sql.NullInt64
+		var charset, collation sql.NullString
+		if err := rows.Scan(&row.ColumnName, &row.OrdinalPosition, &row.DataType, &row.ColumnType, &row.ColumnTypeHex, &precision, &scale, &charset, &collation); err != nil {
+			return result, fmt.Errorf("scan catalog row %d: %w", len(result)+1, err)
+		}
+		if precision.Valid {
+			row.NumericPrecision = &precision.Int64
+		}
+		if scale.Valid {
+			row.NumericScale = &scale.Int64
+		}
+		if charset.Valid {
+			row.CharacterSet = &charset.String
+		}
+		if collation.Valid {
+			row.Collation = &collation.String
+		}
+		result = append(result, row)
+	}
+	if err := rows.Err(); err != nil {
+		return result, fmt.Errorf("iterate catalog after %d rows: %w", len(result), err)
+	}
+	return result, nil
+}
+
+type lifecycle struct {
+	PreCount         *int   `json:"pre_create_count"`
+	Created          bool   `json:"created_by_this_probe"`
+	CleanupAttempted bool   `json:"cleanup_attempted"`
+	DropSucceeded    bool   `json:"drop_succeeded"`
+	PostCount        *int   `json:"post_drop_count"`
+	PrimaryError     string `json:"primary_error,omitempty"`
+	CleanupError     string `json:"cleanup_error,omitempty"`
+}
+
+func collect(ctx context.Context, db *sql.DB, target anchor, ledger *queryLedger, write evidenceWriter) (err error) {
+	life := lifecycle{}
+	defer func() {
+		if err != nil {
+			life.PrimaryError = err.Error()
+		}
+		if life.Created {
+			life.CleanupAttempted = true
+			cleanupCtx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+			defer cancel()
+			_, dropErr := db.ExecContext(cleanupCtx, dropSQL)
+			life.DropSucceeded = dropErr == nil
+			if dropErr != nil {
+				dropErr = fmt.Errorf("cleanup DROP: %w", dropErr)
+			}
+			count, countErr := tableCount(cleanupCtx, db)
+			if countErr == nil {
+				life.PostCount = &count
+				countErr = writeJSON(write, "post-drop-count.json", map[string]int{"count": count})
+				if count != 0 {
+					countErr = errors.Join(countErr, fmt.Errorf("cleanup final COUNT=%d, want 0", count))
+				}
+			} else {
+				countErr = fmt.Errorf("cleanup final COUNT: %w", countErr)
+			}
+			cleanupErr := errors.Join(dropErr, countErr)
+			if cleanupErr != nil {
+				life.CleanupError = cleanupErr.Error()
+				err = errors.Join(err, cleanupErr)
+			}
+		}
+		err = errors.Join(err, writeJSON(write, "lifecycle.json", life))
+		err = errors.Join(err, writeJSON(write, "query-ledger.json", ledger.snapshot()))
+		result := struct {
+			Anchor  string `json:"anchor"`
+			Success bool   `json:"success"`
+			Error   string `json:"error,omitempty"`
+		}{Anchor: target.Name, Success: err == nil}
+		if err != nil {
+			result.Error = err.Error()
+		}
+		err = errors.Join(err, writeJSON(write, "run-result.json", result))
+	}()
+	if err := write("create.sql", []byte(createSQL+"\n")); err != nil {
+		return fmt.Errorf("write create.sql: %w", err)
+	}
+	session := make(map[string]string, len(sessionQueries))
+	for _, fact := range sessionQueries {
+		var value string
+		if err := db.QueryRowContext(ctx, fact.query).Scan(&value); err != nil {
+			return fmt.Errorf("read session %s: %w", fact.name, err)
+		}
+		session[fact.name] = value
+	}
+	if err := writeJSON(write, "session-facts.json", session); err != nil {
+		return err
+	}
+	if err := validateSession(session, target); err != nil {
+		return err
+	}
+	count, err := tableCount(ctx, db)
+	if err != nil {
+		return fmt.Errorf("pre-create: %w", err)
+	}
+	life.PreCount = &count
+	if err := writeJSON(write, "pre-create-count.json", map[string]int{"count": count}); err != nil {
+		return err
+	}
+	if count != 0 {
+		return fmt.Errorf("pre-create COUNT=%d: existing table is not owned by this probe", count)
+	}
+	if _, err := db.ExecContext(ctx, "CREATE DATABASE IF NOT EXISTS golden"); err != nil {
+		return fmt.Errorf("create fixture schema: %w", err)
+	}
+	if _, err := db.ExecContext(ctx, createSQL); err != nil {
+		return fmt.Errorf("create fixture table: %w", err)
+	}
+	life.Created = true
+	catalog, readErr := readCatalog(ctx, db)
+	writeErr := writeJSON(write, "catalog-rows.json", catalog)
+	if err := errors.Join(readErr, writeErr); err != nil {
+		return err
+	}
+	if err := validateCatalog(ctx, catalog); err != nil {
+		return err
+	}
+	providerStart := len(ledger.snapshot())
+	snapshot, providerErr := mysqlmeta.NewProvider(db).LoadTableSnapshot(ctx, target.Dialect, "golden", "t06_a17_type_facts")
+	providerEnd := ledger.snapshot()
+	writeErr = errors.Join(
+		writeJSON(write, "provider-query-ledger.json", providerEnd[providerStart:]),
+		writeJSON(write, "provider-snapshot.json", snapshot),
+	)
+	if err := errors.Join(providerErr, writeErr); err != nil {
+		return fmt.Errorf("provider capture: %w", err)
+	}
+	pairs, err := pairCatalogProvider(catalog, snapshot, target)
+	if err != nil {
+		return err
+	}
+	return writeJSON(write, "catalog-provider-pairs.json", pairs)
+}
+
+func execute(args []string) (err error) {
+	if len(args) != 2 {
+		return fmt.Errorf("usage: t06a17proof <external-output-root> <mysql57|mysql80|mysql84|tidb85>")
+	}
+	target, err := anchorFor(args[1])
+	if err != nil {
+		return err
+	}
+	if os.Getenv("A17_USER") == "" {
+		return fmt.Errorf("A17_USER is required; credentials must be passed through the environment")
+	}
+	if err := os.MkdirAll(args[0], 0o755); err != nil {
+		return fmt.Errorf("create output root: %w", err)
+	}
+	directory := filepath.Join(args[0], target.Name)
+	if err := os.Mkdir(directory, 0o755); err != nil {
+		return fmt.Errorf("create new anchor evidence directory: %w", err)
+	}
+	write := func(name string, data []byte) error {
+		return os.WriteFile(filepath.Join(directory, name), data, 0o644)
+	}
+	cfg := gomysql.NewConfig()
+	cfg.Net = "tcp"
+	cfg.Addr = "127.0.0.1:" + target.Port
+	cfg.User = os.Getenv("A17_USER")
+	cfg.Passwd = os.Getenv("A17_PASS")
+	cfg.InterpolateParams = true
+	cfg.Timeout = 30 * time.Second
+	connector, err := gomysql.NewConnector(cfg)
+	if err != nil {
+		return fmt.Errorf("create connector: %w", err)
+	}
+	ledger := &queryLedger{}
+	db := sql.OpenDB(&ledgerConnector{connector, ledger})
+	db.SetMaxOpenConns(1)
+	defer func() { err = errors.Join(err, db.Close()) }()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	if err := db.PingContext(ctx); err != nil {
+		return fmt.Errorf("ping anchor: %w", err)
+	}
+	if err := collect(ctx, db, target, ledger, write); err != nil {
+		return err
+	}
+	fmt.Printf("anchor=%s columns=24 target_pairs=21 ordinary_controls=3 pre_count=0 post_count=0\n", target.Name)
+	return nil
+}
+
+func main() {
+	if err := execute(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/scripts/t06a17proof/main_test.go b/scripts/t06a17proof/main_test.go
new file mode 100644
index 00000000..19651415
--- /dev/null
+++ b/scripts/t06a17proof/main_test.go
@@ -0,0 +1,329 @@
+// Package main verifies bounded failures in the T06-A17-R1 proof collector.
+// input: controlled database/sql driver rows/errors and failing evidence writers, never live fault injection
+// output: explicit errors for incomplete facts and failed evidence, plus owned-table cleanup assertions
+// pos: task-local collector regression tests; production provider code remains unchanged
+// note: if this file changes, update this header and module README.md.
+package main
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+var fixtureTypes = []string{
+	"decimal(12,2)", "decimal(12,3)", "decimal(12,0)", "decimal(12,0)", "decimal(10,0)",
+	"float(10,2)", "float(10,3)", "float(10,0)", "float", "double(16,2)", "double(16,4)", "double(16,0)", "double",
+	"enum('Ready','Closed')", "enum('ready','closed')", "enum('Closed','Ready')",
+	"set('Read','Write')", "set('read','write')", "set('Write','Read')",
+	"enum('','A,B','A)B','O''Reilly')", "set('Read','A)B','O''Reilly')", "int", "varchar(8)", "bigint unsigned",
+}
+
+type faultFixture struct {
+	catalog         [][]driver.Value
+	provider        [][]driver.Value
+	preCount        driver.Value
+	preError        error
+	postError       error
+	catalogErrorAt  int
+	providerAbsent  bool
+	dropError       error
+	created         bool
+	creates         int
+	drops           int
+	counts          int
+	providerQueries int
+}
+
+func newFaultFixture() *faultFixture {
+	fixture := &faultFixture{preCount: int64(0), catalogErrorAt: -1}
+	for i, name := range columnNames {
+		var precision, scale, charset, collation driver.Value
+		if i < 5 {
+			precision, scale = int64(12), int64(0)
+			if i == 0 {
+				scale = int64(2)
+			} else if i == 1 {
+				scale = int64(3)
+			} else if i == 4 {
+				precision = int64(10)
+			}
+		}
+		if _, ok := memberFacts[name]; ok || name == "v" {
+			charset, collation = "utf8mb4", "utf8mb4_bin"
+		}
+		fixture.catalog = append(fixture.catalog, []driver.Value{name, int64(i + 1), columnFamilies[i], fixtureTypes[i], strings.ToUpper(hex.EncodeToString([]byte(fixtureTypes[i]))), precision, scale, charset, collation})
+		fixture.provider = append(fixture.provider, []driver.Value{name, fixtureTypes[i], charset, collation, "", nil, "YES", ""})
+	}
+	return fixture
+}
+
+type faultConnector struct{ fixture *faultFixture }
+
+type faultDriver struct{}
+
+func (faultDriver) Open(string) (driver.Conn, error) {
+	return nil, errors.New("use the test connector")
+}
+func (c faultConnector) Driver() driver.Driver { return faultDriver{} }
+func (c faultConnector) Connect(context.Context) (driver.Conn, error) {
+	return &faultConn{c.fixture}, nil
+}
+
+type faultConn struct{ fixture *faultFixture }
+
+func (c *faultConn) Close() error { return nil }
+func (c *faultConn) Begin() (driver.Tx, error) {
+	return nil, errors.New("transactions are outside the proof")
+}
+func (c *faultConn) Prepare(string) (driver.Stmt, error) {
+	return nil, errors.New("unexpected prepared query")
+}
+
+func (c *faultConn) ExecContext(_ context.Context, query string, _ []driver.NamedValue) (driver.Result, error) {
+	f := c.fixture
+	switch query {
+	case "CREATE DATABASE IF NOT EXISTS golden":
+	case createSQL:
+		f.creates++
+		f.created = true
+	case dropSQL:
+		f.drops++
+		if f.dropError != nil {
+			return nil, f.dropError
+		}
+		f.created = false
+	default:
+		return nil, fmt.Errorf("unexpected exec %q", query)
+	}
+	return driver.RowsAffected(0), nil
+}
+
+func (c *faultConn) QueryContext(_ context.Context, query string, _ []driver.NamedValue) (driver.Rows, error) {
+	f := c.fixture
+	if query == countSQL {
+		f.counts++
+		if f.counts == 1 {
+			if f.preError != nil {
+				return nil, f.preError
+			}
+			return newFaultRows([]string{"count"}, [][]driver.Value{{f.preCount}}, -1), nil
+		}
+		if f.postError != nil {
+			return nil, f.postError
+		}
+		value := int64(0)
+		if f.created {
+			value = 1
+		}
+		return newFaultRows([]string{"count"}, [][]driver.Value{{value}}, -1), nil
+	}
+	for _, fact := range sessionQueries {
+		if query == fact.query {
+			value := "utf8mb4"
+			switch fact.name {
+			case "version":
+				value = "8.4.10"
+			case "collation_connection":
+				value = "utf8mb4_general_ci"
+			case "sql_mode":
+				value = "STRICT_TRANS_TABLES"
+			}
+			return newFaultRows([]string{fact.name}, [][]driver.Value{{value}}, -1), nil
+		}
+	}
+	if query == catalogSQL {
+		return newFaultRows([]string{"column_name", "ordinal_position", "data_type", "column_type", "hex(column_type)", "numeric_precision", "numeric_scale", "character_set_name", "collation_name"}, f.catalog, f.catalogErrorAt), nil
+	}
+	if strings.Contains(query, "from information_schema.tables") {
+		f.providerQueries++
+		rows := [][]driver.Value{{"InnoDB", "utf8mb4_bin", "", nil, "Dynamic", int64(0)}}
+		if f.providerAbsent {
+			rows = nil
+		}
+		return newFaultRows([]string{"engine", "table_collation", "table_comment", "auto_increment", "row_format", "table_rows"}, rows, -1), nil
+	}
+	if strings.Contains(query, "from information_schema.columns") {
+		f.providerQueries++
+		return newFaultRows([]string{"column_name", "column_type", "character_set_name", "collation_name", "column_comment", "column_default", "is_nullable", "extra"}, f.provider, -1), nil
+	}
+	if strings.Contains(query, "from information_schema.statistics") {
+		f.providerQueries++
+		return newFaultRows([]string{"index_name", "non_unique", "index_type", "column_name", "cardinality"}, nil, -1), nil
+	}
+	return nil, fmt.Errorf("unexpected query %q", query)
+}
+
+type faultRows struct {
+	columns []string
+	rows    [][]driver.Value
+	index   int
+	faultAt int
+}
+
+func newFaultRows(columns []string, rows [][]driver.Value, faultAt int) *faultRows {
+	return &faultRows{columns: columns, rows: rows, faultAt: faultAt}
+}
+func (r *faultRows) Columns() []string { return r.columns }
+func (r *faultRows) Close() error      { return nil }
+func (r *faultRows) Next(values []driver.Value) error {
+	if r.index == r.faultAt {
+		return errors.New("injected catalog stream error")
+	}
+	if r.index >= len(r.rows) {
+		return io.EOF
+	}
+	copy(values, r.rows[r.index])
+	r.index++
+	return nil
+}
+
+func runFixture(t *testing.T, fixture *faultFixture, failFile string) (map[string][]byte, error) {
+	t.Helper()
+	ledger := &queryLedger{}
+	db := sql.OpenDB(&ledgerConnector{faultConnector{fixture}, ledger})
+	t.Cleanup(func() {
+		if err := db.Close(); err != nil {
+			t.Errorf("close controlled DB: %v", err)
+		}
+	})
+	target, err := anchorFor("mysql84")
+	if err != nil {
+		t.Fatal(err)
+	}
+	files := map[string][]byte{}
+	write := func(name string, data []byte) error {
+		if name == failFile {
+			return errors.New("injected evidence write failure")
+		}
+		files[name] = append([]byte(nil), data...)
+		return nil
+	}
+	err = collect(context.Background(), db, target, ledger, write)
+	return files, err
+}
+
+func TestT06A17R1CollectorComplete(t *testing.T) {
+	fixture := newFaultFixture()
+	files, err := runFixture(t, fixture, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fixture.creates != 1 || fixture.drops != 1 || fixture.created || fixture.counts != 2 || fixture.providerQueries != 3 {
+		t.Fatalf("incomplete lifecycle/provider calls: %+v", fixture)
+	}
+	var pairs []pair
+	if err := json.Unmarshal(files["catalog-provider-pairs.json"], &pairs); err != nil || len(pairs) != 24 {
+		t.Fatalf("pairs=%d decode=%v", len(pairs), err)
+	}
+	var result struct{ Success bool }
+	if err := json.Unmarshal(files["run-result.json"], &result); err != nil || !result.Success {
+		t.Fatalf("success record: %s (%v)", files["run-result.json"], err)
+	}
+}
+
+func TestT06A17R1CollectorRejectsFaults(t *testing.T) {
+	for _, tc := range []struct {
+		name, want, failFile string
+		mutate               func(*faultFixture)
+		owned                bool
+	}{
+		{"count-query", "pre-create: table COUNT", "", func(f *faultFixture) { f.preError = errors.New("injected COUNT query error") }, false},
+		{"count-scan", "pre-create: table COUNT", "", func(f *faultFixture) { f.preCount = "not-an-integer" }, false},
+		{"existing-table", "existing table is not owned", "", func(f *faultFixture) { f.preCount = int64(1) }, false},
+		{"rows-error-after-full-set", "iterate catalog after 24 rows", "", func(f *faultFixture) { f.catalogErrorAt = 24 }, true},
+		{"rows-error-mid-stream", "iterate catalog after 3 rows", "", func(f *faultFixture) { f.catalogErrorAt = 3 }, true},
+		{"scan-error", "scan catalog row 2", "", func(f *faultFixture) { f.catalog[1][1] = "bad-ordinal" }, true},
+		{"few-columns", "catalog column count=23", "", func(f *faultFixture) { f.catalog = f.catalog[:23] }, true},
+		{"empty-columns", "catalog column count=0", "", func(f *faultFixture) { f.catalog = nil }, true},
+		{"extra-column", "catalog column count=25", "", func(f *faultFixture) { f.catalog = append(f.catalog, f.catalog[0]) }, true},
+		{"duplicate-column", "duplicate catalog column", "", func(f *faultFixture) { f.catalog[1][0] = "d2" }, true},
+		{"provider-missing-column", "provider=23", "", func(f *faultFixture) { f.provider = f.provider[:23] }, true},
+		{"provider-empty-columns", "provider=0", "", func(f *faultFixture) { f.provider = nil }, true},
+		{"provider-duplicate-column", "duplicate provider column", "", func(f *faultFixture) { f.provider[1] = f.provider[0] }, true},
+		{"provider-absent", "provider snapshot missing", "", func(f *faultFixture) { f.providerAbsent = true }, true},
+		{"evidence-write", "injected evidence write failure", "catalog-rows.json", func(*faultFixture) {}, true},
+		{"post-count-query", "cleanup final COUNT", "", func(f *faultFixture) { f.postError = errors.New("injected final COUNT error") }, true},
+		{"primary-and-cleanup", "catalog column count=23", "", func(f *faultFixture) { f.catalog = f.catalog[:23]; f.dropError = errors.New("injected DROP error") }, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fixture := newFaultFixture()
+			tc.mutate(fixture)
+			files, err := runFixture(t, fixture, tc.failFile)
+			if err == nil || !strings.Contains(err.Error(), tc.want) {
+				t.Fatalf("error=%v, want %q", err, tc.want)
+			}
+			if tc.owned {
+				if fixture.creates != 1 || fixture.drops != 1 || fixture.counts != 2 {
+					t.Fatalf("owned cleanup not attempted: creates=%d drops=%d counts=%d", fixture.creates, fixture.drops, fixture.counts)
+				}
+			} else if fixture.creates != 0 || fixture.drops != 0 {
+				t.Fatalf("unowned table touched: creates=%d drops=%d", fixture.creates, fixture.drops)
+			}
+			var result struct{ Success bool }
+			if decodeErr := json.Unmarshal(files["run-result.json"], &result); decodeErr != nil || result.Success {
+				t.Fatalf("fault recorded as success: %s (%v)", files["run-result.json"], decodeErr)
+			}
+			if tc.name == "count-query" || tc.name == "count-scan" || tc.name == "post-count-query" {
+				var life lifecycle
+				if err := json.Unmarshal(files["lifecycle.json"], &life); err != nil {
+					t.Fatal(err)
+				}
+				if tc.name == "post-count-query" && life.PostCount != nil || tc.name != "post-count-query" && life.PreCount != nil {
+					t.Fatalf("failed COUNT fabricated an integer: %+v", life)
+				}
+			}
+			if tc.name == "primary-and-cleanup" && (!strings.Contains(err.Error(), "injected DROP error") || !strings.Contains(err.Error(), "final COUNT=1")) {
+				t.Fatalf("primary/cleanup errors lost: %v", err)
+			}
+			t.Logf("constructed fault rejected: %v", err)
+		})
+	}
+}
+
+func TestT06A17R1IndependentFacts(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		mutate func(*faultFixture)
+	}{
+		{"decimal-precision", func(f *faultFixture) { f.catalog[0][5] = int64(11) }},
+		{"members-both-sides-corrupt", func(f *faultFixture) {
+			value := "enum('ready','Closed')"
+			f.catalog[13][3] = value
+			f.catalog[13][4] = strings.ToUpper(hex.EncodeToString([]byte(value)))
+			f.provider[13][1] = value
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			fixture := newFaultFixture()
+			tc.mutate(fixture)
+			if _, err := runFixture(t, fixture, ""); err == nil {
+				t.Fatal("independent input fact corruption accepted")
+			}
+		})
+	}
+}
+
+func TestT06A17R1EvidenceEncodingAndDiskErrors(t *testing.T) {
+	if err := writeJSON(func(string, []byte) error { return nil }, "unsupported.json", func() {}); err == nil {
+		t.Fatal("JSON encoding failure accepted")
+	}
+	blocker := filepath.Join(t.TempDir(), "not-a-directory")
+	if err := os.WriteFile(blocker, []byte("fixture"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeJSON(func(name string, data []byte) error {
+		return os.WriteFile(filepath.Join(blocker, name), data, 0o644)
+	}, "evidence.json", true); err == nil {
+		t.Fatal("disk write failure accepted")
+	}
+}
