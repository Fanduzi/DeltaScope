+func TestT18HTTPViewPrivacy(t *testing.T) {
+	for _, mode := range []string{"known", "unavailable", "error"} {
+		t.Run(mode, func(t *testing.T) {
+			provider := &t18HTTPViewProvider{mode: mode}
+			var logs bytes.Buffer
