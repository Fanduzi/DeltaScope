+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			result, err := Audit(context.Background(), Request{
+				SQL: sqlText, Dialect: DialectMySQL, Schema: "g", ConfigPath: path,
+				MetadataProvider: t18FirstProvider{sourceMode: tc.mode},
