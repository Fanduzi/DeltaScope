+func TestT18FirstCrossSchemaSourcesBindRequestSchema(t *testing.T) {
+	provider := t18FirstFixture()
+	target := cloneTableSnapshot(provider.tables["g.v"])
+	target.Schema, target.Table.Schema = "other", "other"
+	provider.tables["other.v"] = target
+	_, statements := t18FirstEnrich(t, provider, "ALTER VIEW other.v AS SELECT id FROM t;")
+	source := statements[0].Metadata.View.Sources[0]
+	if source.Table != (spec.Table{Schema: "g", Name: "t"}) || source.Snapshot == nil || !source.Snapshot.Exists {
+		t.Fatalf("source=%#v", source)
+	}
+}
+
+func TestT18FirstDependencyLimitIsIntrinsic(t *testing.T) {
+	provider := t18FirstFixture()
+	for i := 1; i <= 33; i++ {
+		name := fmt.Sprintf("v%d", i)
+		source := "t"
+		if i < 33 {
+			source = fmt.Sprintf("v%d", i+1)
+		}
+		provider.tables["g."+name] = &spec.TableSnapshot{
+			Schema: "g", Table: &spec.Table{Schema: "g", Name: name}, Exists: true,
+			RelationKind: "view", Columns: []spec.Column{{Name: "id", Type: "int"}},
+			View: &spec.ViewSnapshot{Security: "definer", Definition: &spec.ViewDefinition{
+				SourcesKnown: true, Sources: []spec.Table{{Schema: "g", Name: source}},
+			}},
+		}
+	}
+	_, statements := t18FirstEnrich(t, provider, "ALTER VIEW v AS SELECT id FROM v1;")
+	if !statements[0].Metadata.View.DependencyLimit {
+		t.Fatal("depth limit was not recorded")
+	}
+	assessment := spec.AssessViewLifecycle(statements[0])
+	if !assessment.DependencyLimit || len(assessment.SourceRequired) != 0 {
+		t.Fatalf("limit confused with missing metadata: %#v", assessment)
+	}
+	cfg, err := apppolicy.Load(t05PolicyPathConfigured(t, map[string]t05RuleConfig{}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	registry, err := buildRegistry(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := EvaluateStatements(context.Background(), registry, statements)
+	if err != nil || string(result.Coverage.Status) != "incomplete" || len(result.Unsupported) != 1 ||
+		result.Unsupported[0].Feature != "view.dependencies.limit" || len(result.Statements[0].EvidenceGaps) != 0 {
+		t.Fatalf("result=%#v err=%v", result, err)
+	}
+}
diff --git a/internal/application/audit/batch_state_view.go b/internal/application/audit/batch_state_view.go
new file mode 100644
index 00000000..6f6d6ccb
--- /dev/null
+++ b/internal/application/audit/batch_state_view.go
@@ -0,0 +1,262 @@
+package audit
+
+import (
+	"context"
+	"strings"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+)
+
+type viewStateReadError struct{ cause error }
+
+func (viewStateReadError) Error() string   { return "view metadata read failed" }
+func (e viewStateReadError) Unwrap() error { return e.cause }
+
+func (s *batchState) applyDropView(statement spec.Statement) error {
+	assessment := spec.AssessViewLifecycle(statement)
+	for _, target := range assessment.DropTargets {
+		key := s.keyFor(s.schema, target.Binding.Table)
+		switch target.Fate {
+		case spec.ViewDropRemove:
+			s.entries[key] = &batchTableEntry{state: tableAbsent, displaySchema: key.schema, displayTable: key.table}
+		case spec.ViewDropUnknown:
+			s.entries[key] = &batchTableEntry{state: tableUnknown, notView: target.Binding.NotView, displaySchema: key.schema, displayTable: key.table}
+		case spec.ViewDropNotView:
+			s.entries[key] = &batchTableEntry{state: tableUnknown, notView: true, displaySchema: key.schema, displayTable: key.table}
+		}
+	}
+	return nil
+}
+
+func (s *batchState) projectViewMetadata(ctx context.Context, statement spec.Statement, target *spec.TableSnapshot, targets []spec.TargetBinding, sources []*spec.TableSnapshot) (*spec.ViewMetadata, error) {
+	key := s.keyFor(s.schema, *statement.DDL.Table)
+	metadata := &spec.ViewMetadata{
+		TargetIdentity:      spec.Table{Schema: key.schema, Name: key.table},
+		Target:              target,
+		DependencyCycleRoot: -1,
+	}
+	for _, target := range targets {
+		targetKey := s.keyFor(s.schema, target.Table)
+		target.Table = spec.Table{Schema: targetKey.schema, Name: targetKey.table}
+		metadata.Targets = append(metadata.Targets, target)
+	}
+	definition := statement.DDL.View.Definition
+	if definition == nil {
+		return metadata, nil
+	}
+	if len(definition.Sources) > 256 || definition.QueryLimit {
+		metadata.DependencyLimit = true
+		return metadata, nil
+	}
+	for i, source := range definition.Sources {
+		sourceKey := s.keyFor(s.schema, source)
+		binding := spec.TargetBinding{Table: spec.Table{Schema: sourceKey.schema, Name: sourceKey.table}}
+		if i < len(sources) {
+			binding.Snapshot = sources[i]
+		}
+		metadata.Sources = append(metadata.Sources, binding)
+	}
+	seen := map[batchTableKey]struct{}{}
+	path := map[batchTableKey]bool{key: true}
+	edges := 0
+	var visit func(spec.TargetBinding, int, int) error
+	visit = func(binding spec.TargetBinding, depth, root int) error {
+		current := s.keyFor(s.schema, binding.Table)
+		if path[current] {
+			if !metadata.DependencyCycle {
+				metadata.DependencyCycleRoot = root
+			}
+			metadata.DependencyCycle = true
+			return nil
+		}
+		if _, exists := seen[current]; exists {
+			return nil
+		}
+		if depth > 32 || len(seen) >= 256 {
+			metadata.DependencyLimit = true
+			return nil
+		}
+		seen[current] = struct{}{}
+		snapshot := binding.Snapshot
+		if snapshot == nil || !snapshot.Exists || snapshot.RelationKind != "view" ||
+			snapshot.View == nil || snapshot.View.Definition == nil ||
+			!snapshot.View.Definition.SourcesKnown {
+			return nil
+		}
+		path[current] = true
+		defer delete(path, current)
+		selected := spec.SelectViewDefinition(snapshot.View.Definition, s.dialect)
+		if selected.QueryLimit || len(selected.Sources) > 256 {
+			metadata.DependencyLimit = true
+			return nil
+		}
+		check := spec.ViewDependencyProjection{Root: root, Definition: selected}
+		for _, source := range selected.Sources {
+			if strings.TrimSpace(source.Schema) == "" {
+				metadata.DependencyUnproven = true
+				check.Sources = append(check.Sources, spec.TargetBinding{Table: source})
+				continue
+			}
+			if edges >= 1024 {
+				metadata.DependencyLimit = true
+				break
+			}
+			edges++
+			ns, entry, sourceKey, err := s.bindSource(ctx, source)
+			if err != nil {
+				return err
+			}
+			dependency := s.projectBoundSnapshot(sourceKey, ns, entry)
+			dependency.Table = spec.Table{Schema: sourceKey.schema, Name: sourceKey.table}
+			metadata.Dependencies = append(metadata.Dependencies, dependency)
+			metadata.DependencyRoots = append(metadata.DependencyRoots, root)
+			check.Sources = append(check.Sources, dependency)
+			if err := visit(dependency, depth+1, root); err != nil {
+				return err
+			}
+			if metadata.DependencyLimit {
+				break
+			}
+		}
+		metadata.DependencyChecks = append(metadata.DependencyChecks, check)
+		return nil
+	}
+	for i, source := range metadata.Sources {
+		if metadata.DependencyLimit {
+			break
+		}
+		if err := visit(source, 1, i); err != nil {
+			return nil, err
+		}
+	}
+	return metadata, nil
+}
+
+func (s *batchState) applyView(statement spec.Statement) error {
+	ddl := statement.DDL
+	if ddl == nil || ddl.View == nil || ddl.Table == nil || statement.Metadata == nil || statement.Metadata.View == nil {
+		return nil
+	}
+	assessment := spec.AssessViewLifecycle(statement)
+	if assessment.TargetInvalid || assessment.SourceInvalid || assessment.CheckInvalid {
+		return nil
+	}
+	key := s.keyFor(s.schema, *ddl.Table)
+	if len(assessment.TargetRequired) != 0 || len(assessment.SourceRequired) != 0 ||
+		len(assessment.CheckRequired) != 0 || assessment.DependencyLimit || len(ddl.UnextractedOptions) != 0 {
+		prior := statement.Metadata.View.Target
+		if ddl.Operation == spec.DDLOperationAlterView && prior != nil && prior.Exists && prior.RelationKind == "view" {
+			shape := cloneTableSnapshot(prior)
+			shape.Columns = nil
+			if shape.View != nil {
+				shape.View.Definition = nil
+				shape.View.Updatable = nil
+				if ddl.View.AlgorithmExplicit && ddl.View.Algorithm != "undefined" {
+					shape.View.Algorithm = ""
+				}
+				if ddl.View.DefinerKind != "" {
+					shape.View.DefinerKind = ""
+					shape.View.DefinerPrincipal = ""
+				}
+				if ddl.View.SecurityExplicit && shape.View.Security != ddl.View.Security {
+					shape.View.Security = ""
+				}
+				check := "none"
+				if ddl.View.CheckExplicit {
+					check = ddl.View.CheckOption
+				}
+				if shape.View.CheckOption != check {
+					shape.View.CheckOption = ""
+				}
+			}
+			s.entries[key] = &batchTableEntry{state: tablePresent, shape: shape, displaySchema: prior.Schema, displayTable: ddl.Table.Name}
+		} else {
+			s.invalidateKey(key)
+		}
+		return nil
+	}
+	var shape *spec.TableSnapshot
+	if ddl.Operation == spec.DDLOperationAlterView {
+		shape = cloneTableSnapshot(statement.Metadata.View.Target)
+	} else {
+		shape = &spec.TableSnapshot{
+			Schema: key.schema, Table: &spec.Table{Schema: key.schema, Name: key.table},
+			Exists: true, RelationKind: "view",
+		}
+	}
+	if shape.View == nil {
+		shape.View = &spec.ViewSnapshot{}
+	}
+	definition := spec.FreezeViewDefinition(ddl.View.Definition, statement.Metadata.View.Sources, statement.Dialect)
+	for i := range definition.Sources {
+		definition.Sources[i] = statement.Metadata.View.Sources[i].Table
+	}
+	spec.BindViewDefinitionSources(definition, statement.Metadata.View.Sources)
+	shape.View.Definition = definition
+	shape.View.Security = assessment.Security
+	if ddl.Operation == spec.DDLOperationCreateView {
+		shape.View.Algorithm = "undefined"
+		shape.View.DefinerKind = "current_user"
+		shape.View.DefinerPrincipal = ""
+	}
+	if ddl.View.AlgorithmExplicit && (ddl.Operation == spec.DDLOperationCreateView || ddl.View.Algorithm != "undefined") {
+		shape.View.Algorithm = ddl.View.Algorithm
+		if ddl.View.Algorithm == "merge" && definition.NonMergeable && statement.Dialect == spec.DialectMySQL {
+			shape.View.Algorithm = "undefined"
+		}
+	}
+	if ddl.View.DefinerKind != "" {
+		shape.View.DefinerKind = ddl.View.DefinerKind
+		shape.View.DefinerPrincipal = ddl.View.DefinerPrincipal
+	}
+	shape.View.CheckOption = "none"
+	if statement.Dialect == spec.DialectTiDB {
+		shape.View.CheckOption = "cascaded"
+	}
+	if ddl.View.CheckExplicit {
+		shape.View.CheckOption = ddl.View.CheckOption
+	}
+	shape.View.Updatable = nil
+	shape.Columns = nil
+	if definition.ShapeKnown {
+		if definition.Query != nil {
+			definition.Bindings = append([]spec.ViewColumnBinding(nil), definition.Query.Bindings...)
+		} else {
+			var source *spec.TableSnapshot
+			if len(statement.Metadata.View.Sources) == 1 {
+				source = statement.Metadata.View.Sources[0].Snapshot
+			}
+			var frozen []spec.ViewColumnBinding
+			for _, binding := range definition.Bindings {
+				if !binding.Star {
+					frozen = append(frozen, binding)
+					continue
+				}
+				if source == nil {
+					continue
+				}
+				for _, column := range source.Columns {
+					if strings.EqualFold(column.Visibility, "invisible") {
+						continue
+					}
+					frozen = append(frozen, spec.ViewColumnBinding{
+						Schema: binding.Schema, Table: binding.Table, Column: column.Name,
+						Output: column.Name, Offset: binding.Offset,
+					})
+				}
+			}
+			definition.Bindings = frozen
+		}
+		if assessment.OutputNamesKnown {
+			shape.Columns = make([]spec.Column, 0, len(assessment.OutputNames))
+			for i, name := range assessment.OutputNames {
+				shape.Columns = append(shape.Columns, spec.Column{Name: name})
+				if i < len(definition.Bindings) {
+					definition.Bindings[i].Output = name
+				}
+			}
+		}
+	}
+	s.entries[key] = &batchTableEntry{state: tablePresent, shape: shape, displaySchema: key.schema, displayTable: key.table}
+	return nil
+}
diff --git a/internal/domain/rule/ddl/view_lifecycle_rules.go b/internal/domain/rule/ddl/view_lifecycle_rules.go
new file mode 100644
index 00000000..7651d99c
--- /dev/null
+++ b/internal/domain/rule/ddl/view_lifecycle_rules.go
@@ -0,0 +1,242 @@
+package ddl
+
+import (
+	"context"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/policy"
+	"github.com/Fanduzi/DeltaScope/internal/domain/rule"
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+)
+
+type viewLifecycleRule struct {
+	ruleID string
+	level  rule.Level
+}
+
+func newViewLifecycleRule(id string, fallback rule.Level, cfg policy.RulePolicy) rule.StatementRule {
+	return viewLifecycleRule{ruleID: id, level: configuredLevel(cfg, fallback)}
+}
+
+func (r viewLifecycleRule) ID() string { return r.ruleID }
+
+func (r viewLifecycleRule) AppliesTo(statement spec.Statement) bool {
+	switch r.ruleID {
+	case "ddl.view.target.valid", "ddl.view.source.valid", "ddl.view.security.definer.warn":
+		if !orderedGapDialect(statement.Dialect) {
+			return false
+		}
+	case "ddl.view.algorithm.warn", "ddl.view.check_option.valid":
+		if statement.Dialect != spec.DialectMySQL {
+			return false
+		}
+	case "ddl.view.options.ignored.warn":
+		if statement.Dialect != spec.DialectTiDB {
+			return false
+		}
+	default:
+		return false
+	}
+	if statement.Kind != spec.KindDDL || statement.DDL == nil || statement.DDL.View == nil || statement.Unsupported != nil {
+		return false
+	}
+	if statement.DDL.Operation == spec.DDLOperationDropView {
+		return r.ruleID == "ddl.view.target.valid"
+	}
+	return statement.DDL.Operation == spec.DDLOperationCreateView || statement.DDL.Operation == spec.DDLOperationAlterView
+}
+
+func (r viewLifecycleRule) Evaluate(ctx context.Context, statement spec.Statement) ([]rule.Finding, error) {
+	if !r.AppliesTo(statement) {
+		return nil, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	assessment := spec.AssessViewLifecycle(statement)
+	if statement.DDL.Operation == spec.DDLOperationDropView {
+		var findings []rule.Finding
+		for i, target := range assessment.DropTargets {
+			if !target.Invalid {
+				continue
+			}
+			metadata := map[string]any{
+				"role": "target", "view": target.Binding.Table.Name, "view_schema": target.Binding.Table.Schema,
+			}
+			var location *rule.Location
+			if i < len(statement.DDL.View.TargetOffsets) {
+				location = viewOffsetLocation(statement, statement.DDL.View.TargetOffsets[i])
+			}
+			findings = append(findings, rule.Finding{
+				RuleID: r.ruleID, Level: r.level, Message: "view target is invalid for this operation",
+				Suggestion: "check the target relation and operation", Metadata: metadata, Location: location,
+			})
+		}
+		return findings, nil
+	}
+	if r.ruleID == "ddl.view.source.valid" && assessment.SourceInvalid && len(assessment.SourceFailures) > 0 {
+		findings := make([]rule.Finding, 0, len(assessment.SourceFailures))
+		for _, failure := range assessment.SourceFailures {
+			item := assessment
+			item.SourceRootIndex, item.SourceBindingIndex, item.SourceOffset = failure.Root, failure.BindingIndex, failure.Offset
+			findings = append(findings, rule.Finding{
+				RuleID: r.ruleID, Level: r.level, Message: "view definition has an invalid source",
+				Suggestion: "check the authored source relations and columns",
+				Metadata:   viewFindingMetadata(statement, item, "source"), Location: viewSourceLocation(statement, item),
+			})
+		}
+		return findings, nil
+	}
+	if r.ruleID == "ddl.view.options.ignored.warn" {
+		var findings []rule.Finding
+		for _, option := range []struct {
+			explicit bool
+			role     string
+			offset   int
+		}{
+			{statement.DDL.View.AlgorithmExplicit, "algorithm", statement.DDL.View.AlgorithmOffset},
+			{statement.DDL.View.CheckExplicit, "check", statement.DDL.View.CheckOffset},
+		} {
+			if option.explicit {
+				findings = append(findings, rule.Finding{
+					RuleID: r.ruleID, Level: r.level,
+					Message:    "view option does not provide the requested guarantee",
+					Suggestion: "review the vendor's supported view behavior",
+					Metadata:   viewFindingMetadata(statement, assessment, option.role),
+					Location:   viewOffsetLocation(statement, option.offset),
+				})
+			}
+		}
+		return findings, nil
+	}
+	var message, suggestion, role string
+	switch r.ruleID {
+	case "ddl.view.target.valid":
+		if assessment.TargetInvalid {
+			message = "view target is invalid for this operation"
+			suggestion = "check the target relation and operation"
+			role = "target"
+		}
+	case "ddl.view.source.valid":
+		if assessment.SourceInvalid {
+			message = "view definition has an invalid source"
+			suggestion = "check the authored source relations and columns"
+			role = "source"
+		}
+	case "ddl.view.security.definer.warn":
+		if assessment.Security == "definer" || assessment.ReviewPrincipal {
+			message = "view security or named definer requires review"
+			suggestion = "review the view's privilege context"
+			role = "view"
+		}
+	case "ddl.view.algorithm.warn":
+		if assessment.AlgorithmWarn {
+			message = "view algorithm requires review"
+			suggestion = "review the requested algorithm and view definition"
+			role = "algorithm"
+		}
+	case "ddl.view.check_option.valid":
+		if assessment.CheckInvalid {
+			message = "view check option requires an updatable view"
+			suggestion = "use an updatable view definition"
+			role = "check"
+		}
+	}
+	if message == "" {
+		return nil, nil
+	}
+	finding := rule.Finding{
+		RuleID: r.ruleID, Level: r.level, Message: message, Suggestion: suggestion,
+		Metadata: viewFindingMetadata(statement, assessment, role),
+	}
+	if role == "source" {
+		finding.Location = viewSourceLocation(statement, assessment)
+	} else if role == "algorithm" {
+		finding.Location = viewOffsetLocation(statement, statement.DDL.View.AlgorithmOffset)
+	} else if role == "check" {
+		finding.Location = viewOffsetLocation(statement, statement.DDL.View.CheckOffset)
+	} else if role == "view" && assessment.ReviewPrincipal {
+		finding.Location = viewOffsetLocation(statement, statement.DDL.View.DefinerOffset)
+	} else if role == "view" && statement.DDL.View.SecurityExplicit {
+		finding.Location = viewOffsetLocation(statement, statement.DDL.View.SecurityOffset)
+	}
+	return []rule.Finding{finding}, nil
+}
+
+func viewFindingMetadata(statement spec.Statement, assessment spec.ViewLifecycleAssessment, role string) map[string]any {
+	var target spec.Table
+	if statement.DDL.Table != nil {
+		target = *statement.DDL.Table
+	}
+	if statement.Metadata != nil && statement.Metadata.View != nil {
+		target = statement.Metadata.View.TargetIdentity
+	}
+	metadata := map[string]any{"role": role, "view": target.Name, "view_schema": target.Schema}
+	if role == "source" && assessment.SourceRootIndex >= 0 &&
+		statement.Metadata != nil && statement.Metadata.View != nil &&
+		assessment.SourceRootIndex < len(statement.Metadata.View.Sources) {
+		source := statement.Metadata.View.Sources[assessment.SourceRootIndex].Table
+		metadata["schema"] = source.Schema
+		metadata["table"] = source.Name
+	}
+	return metadata
+}
+
+func viewSourceLocation(statement spec.Statement, assessment spec.ViewLifecycleAssessment) *rule.Location {
+	if statement.Line <= 0 || statement.Column <= 0 || statement.DDL.View.Definition == nil {
+		return nil
+	}
+	definition := statement.DDL.View.Definition
+	offset := assessment.SourceOffset
+	if offset >= 0 {
+		return viewOffsetLocation(statement, offset)
+	}
+	if assessment.SourceBindingIndex >= 0 && assessment.SourceBindingIndex < len(definition.Bindings) {
+		offset = definition.Bindings[assessment.SourceBindingIndex].Offset
+	} else if index := assessment.SourceBindingIndex - len(definition.Bindings); index >= 0 && index < len(definition.References) {
+		offset = definition.References[index].Offset
+	}
+	if offset < 0 && assessment.SourceRootIndex >= 0 && assessment.SourceRootIndex < len(definition.SourceOffsets) {
+		offset = definition.SourceOffsets[assessment.SourceRootIndex]
+	}
+	return viewOffsetLocation(statement, offset)
+}
+
+func viewOffsetLocation(statement spec.Statement, offset int) *rule.Location {
+	if statement.Line <= 0 || statement.Column <= 0 || offset < 0 || offset > len(statement.RawSQL) {
+		return nil
+	}
+	location := &rule.Location{Line: statement.Line, Column: statement.Column}
+	for _, r := range statement.RawSQL[:offset] {
+		if r == '\n' {
+			location.Line++
+			location.Column = 1
+		} else {
+			location.Column++
+		}
+	}
+	return location
+}
+
+func (r viewLifecycleRule) EvidenceGaps(statement spec.Statement) []rule.EvidenceGap {
+	if !r.AppliesTo(statement) {
+		return nil
+	}
+	assessment := spec.AssessViewLifecycle(statement)
+	var facts []string
+	switch r.ruleID {
+	case "ddl.view.target.valid":
+		facts = assessment.TargetRequired
+	case "ddl.view.source.valid":
+		facts = assessment.SourceRequired
+	case "ddl.view.security.definer.warn":
+		if assessment.SecurityUnknown {
+			facts = []string{"view.security"}
+		}
+	case "ddl.view.check_option.valid":
+		facts = assessment.CheckRequired
+	}
+	if len(facts) == 0 {
+		return nil
+	}
+	return []rule.EvidenceGap{{ReasonCode: gapReasonUnknownTableState, RequiredFacts: facts}}
+}
diff --git a/internal/domain/spec/view.go b/internal/domain/spec/view.go
new file mode 100644
index 00000000..21e02e41
--- /dev/null
+++ b/internal/domain/spec/view.go
@@ -0,0 +1,796 @@
+package spec
+
+import "strings"
+
+type ViewDeclaration struct {
+	OrReplace         bool
+	Columns           []string
+	Algorithm         string
+	AlgorithmExplicit bool
+	AlgorithmOffset   int `json:"-"`
+	Security          string
+	SecurityExplicit  bool
+	SecurityOffset    int `json:"-"`
+	CheckOption       string
+	CheckExplicit     bool
+	CheckBare         bool
+	CheckOffset       int `json:"-"`
+	DefinerKind       string
+	DefinerOffset     int    `json:"-"`
+	DefinerPrincipal  string `json:"-"`
+	Definition        *ViewDefinition
+	TargetOffsets     []int `json:"-"`
+}
+
+type ViewDefinition struct {
+	SQL              string `json:"-"`
+	Sources          []Table
+	SourceAliases    []string
+	SourceOffsets    []int `json:"-"`
+	SourcesKnown     bool
+	Bindings         []ViewColumnBinding
+	References       []ViewColumnBinding `json:"-"`
+	ShapeKnown       bool
+	UnlabeledComplex bool       `json:"-"`
+	NonMergeable     bool       `json:"-"`
+	NonUpdatable     bool       `json:"-"`
+	HasCTE           bool       `json:"-"`
+	Query            *ViewQuery `json:"-"`
+	QueryLimit       bool       `json:"-"`
+}
+
+type ViewQuery struct {
+	Sources       []ViewQuerySource
+	Bindings      []ViewColumnBinding
+	References    []ViewColumnBinding
+	With          []*ViewQuery
+	Subqueries    []*ViewQuery
+	SetOperands   []*ViewQuery
+	ColumnAliases []string
+	Unsupported   bool
+	Limited       bool
+	NonMergeable  bool
+	NonUpdatable  bool
+	Unlabeled     bool
+}
+
+type ViewQuerySource struct {
+	Table  *Table
+	Alias  string
+	Query  *ViewQuery
+	Offset int
+	Index  int
+}
+
+type ViewColumnBinding struct {
+	Schema          string
+	Table           string
+	Column          string
+	Output          string
+	Offset          int  `json:"-"`
+	Star            bool `json:"-"`
+	Expression      bool `json:"-"`
+	OutputReference bool `json:"-"`
+}
+
+type ViewDependencyProjection struct {
+	Root       int
+	Definition *ViewDefinition
+	Sources    []TargetBinding
+}
+
+type ViewSnapshot struct {
+	Definition       *ViewDefinition
+	Algorithm        string
+	Security         string
+	CheckOption      string
+	Updatable        *bool
+	DefinerKind      string
+	DefinerPrincipal string `json:"-"`
+}
+
+type ViewMetadata struct {
+	TargetIdentity      Table
+	Target              *TableSnapshot
+	Targets             []TargetBinding `json:"-"`
+	Sources             []TargetBinding
+	Dependencies        []TargetBinding
+	DependencyRoots     []int
+	DependencyChecks    []ViewDependencyProjection `json:"-"`
+	DependencyCycle     bool
+	DependencyCycleRoot int
+	DependencyUnproven  bool
+	DependencyLimit     bool
+}
+
+type ViewLifecycleAssessment struct {
+	TargetInvalid      bool
+	SourceInvalid      bool
+	SourceRootIndex    int
+	SourceBindingIndex int
+	SourceOffset       int
+	SourceFailures     []ViewSourceFailure
+	OutputNames        []string
+	OutputNamesKnown   bool
+	TargetRequired     []string
+	SourceRequired     []string
+	Security           string
+	SecurityUnknown    bool
+	ReviewPrincipal    bool
+	DependencyLimit    bool
+	AlgorithmWarn      bool
+	CheckInvalid       bool
+	CheckRequired      []string
+	DropTargets        []ViewDropTarget
+}
+
+type ViewSourceFailure struct {
+	Root         int
+	BindingIndex int
+	Offset       int
+}
+
+type ViewDropFate uint8
+
+const (
+	ViewDropKeep ViewDropFate = iota
+	ViewDropRemove
+	ViewDropUnknown
+	ViewDropNotView
+)
+
+type ViewDropTarget struct {
+	Binding TargetBinding
+	Invalid bool
+	Fate    ViewDropFate
+}
+
+func appendViewFact(facts []string, fact string) []string {
+	for _, existing := range facts {
+		if existing == fact {
+			return facts
+		}
+	}
+	return append(facts, fact)
+}
+
+func sameViewIdentity(a, b Table) bool {
+	return strings.EqualFold(a.Schema, b.Schema) && strings.EqualFold(a.Name, b.Name)
+}
+
+func AssessViewLifecycle(statement Statement) ViewLifecycleAssessment {
+	assessment := ViewLifecycleAssessment{SourceRootIndex: -1, SourceBindingIndex: -1, SourceOffset: -1}
+	if statement.DDL == nil || statement.DDL.View == nil {
+		return assessment
+	}
+	ddl := statement.DDL
+	assessment.ReviewPrincipal = ddl.View.DefinerKind == "named"
+	var metadata *ViewMetadata
+	if statement.Metadata != nil {
+		metadata = statement.Metadata.View
+	}
+	if metadata == nil {
+		assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "table.exists")
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "table.exists")
+		assessment.SecurityUnknown = true
+		return assessment
+	}
+	if ddl.Operation == DDLOperationDropView {
+		return assessDropView(statement, metadata)
+	}
+	switch {
+	case len(metadata.Targets) > 0 && metadata.Targets[0].NotView && ddl.Operation == DDLOperationAlterView:
+		assessment.TargetInvalid = true
+	case metadata.Target == nil:
+		assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "table.exists")
+	case ddl.Operation == DDLOperationAlterView && !metadata.Target.Exists:
+		assessment.TargetInvalid = true
+	case ddl.Operation == DDLOperationCreateView && metadata.Target.Exists && !ddl.View.OrReplace:
+		assessment.TargetInvalid = true
+	case metadata.Target.Exists && metadata.Target.RelationKind == "":
+		assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "relation.kind")
+	case ddl.Operation == DDLOperationAlterView && metadata.Target.RelationKind != "view":
+		assessment.TargetInvalid = true
+	case ddl.Operation == DDLOperationCreateView && metadata.Target.Exists &&
+		(!ddl.View.OrReplace || metadata.Target.RelationKind != "view"):
+		assessment.TargetInvalid = true
+	}
+	if ddl.View.SecurityExplicit {
+		assessment.Security = ddl.View.Security
+	} else if ddl.Operation == DDLOperationCreateView && (statement.Dialect == DialectMySQL || statement.Dialect == DialectTiDB) {
+		assessment.Security = "definer"
+	} else if metadata.Target != nil && metadata.Target.View != nil {
+		assessment.Security = metadata.Target.View.Security
+	}
+	assessment.SecurityUnknown = assessment.Security == "" &&
+		!(ddl.Operation == DDLOperationAlterView && assessment.TargetInvalid && !ddl.View.SecurityExplicit)
+	definition := ddl.View.Definition
+	if statement.Dialect == DialectMySQL {
+		assessment.AlgorithmWarn = ddl.View.AlgorithmExplicit &&
+			(ddl.View.Algorithm == "temptable" || ddl.View.Algorithm == "merge" && definition != nil && definition.NonMergeable)
+		if ddl.View.CheckExplicit {
+			effectiveAlgorithm := ddl.View.Algorithm
+			if ddl.Operation == DDLOperationAlterView && (!ddl.View.AlgorithmExplicit || effectiveAlgorithm == "undefined") &&
+				metadata.Target != nil && metadata.Target.View != nil {
+				effectiveAlgorithm = metadata.Target.View.Algorithm
+			}
+			if effectiveAlgorithm == "temptable" || definition != nil && definition.NonUpdatable {
+				assessment.CheckInvalid = true
+			} else if definition != nil && definition.ShapeKnown && len(metadata.Sources) == 1 {
+				source := metadata.Sources[0].Snapshot
+				if source == nil || source.Exists && source.RelationKind == "" {
+					assessment.CheckRequired = appendViewFact(assessment.CheckRequired, "view.updatable")
+				} else if source.Exists && source.RelationKind == "view" &&
+					(source.View == nil || source.View.Updatable == nil) {
+					assessment.CheckRequired = appendViewFact(assessment.CheckRequired, "view.updatable")
+				} else if source != nil && source.View != nil && source.View.Updatable != nil && !*source.View.Updatable {
+					assessment.CheckInvalid = true
+				}
+			}
+			if ddl.Operation == DDLOperationAlterView && !assessment.TargetInvalid &&
+				(!ddl.View.AlgorithmExplicit || ddl.View.Algorithm == "undefined") &&
+				effectiveAlgorithm == "" && !assessment.CheckInvalid {
+				assessment.CheckRequired = appendViewFact(assessment.CheckRequired, "view.algorithm")
+			}
+		}
+	}
+	assessment.DependencyLimit = metadata.DependencyLimit
+	if metadata.DependencyLimit && definition != nil && (len(definition.Sources) > 256 || definition.QueryLimit) {
+		return assessment
+	}
+	shapeUnsupported := false
+	for _, option := range ddl.UnextractedOptions {
+		if option == "view_query_shape" {
+			shapeUnsupported = true
+			break
+		}
+	}
+	if definition == nil || !definition.SourcesKnown {
+		if !shapeUnsupported {
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+		}
+	} else if len(metadata.Sources) != len(definition.Sources) {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+	}
+	markSourceOffset := func(root, binding, offset int) {
+		if !assessment.SourceInvalid {
+			assessment.SourceRootIndex = root
+			assessment.SourceBindingIndex = binding
+			assessment.SourceOffset = offset
+		}
+		assessment.SourceInvalid = true
+		for _, existing := range assessment.SourceFailures {
+			if existing.Root == root {
+				return
+			}
+		}
+		assessment.SourceFailures = append(assessment.SourceFailures, ViewSourceFailure{Root: root, BindingIndex: binding, Offset: offset})
+	}
+	markSourceInvalid := func(root, binding int) {
+		markSourceOffset(root, binding, -1)
+	}
+	if definition != nil && definition.HasCTE && statement.Dialect == DialectMySQL &&
+		(statement.Metadata == nil || statement.Metadata.Version == nil || statement.Metadata.Version.Major == 0) {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "database.version")
+	}
+	if metadata.DependencyCycle {
+		markSourceInvalid(metadata.DependencyCycleRoot, -1)
+	}
+	if metadata.DependencyUnproven {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+	}
+	all := make([]TargetBinding, 0, len(metadata.Sources)+len(metadata.Dependencies))
+	all = append(all, metadata.Sources...)
+	all = append(all, metadata.Dependencies...)
+	for i, source := range all {
+		root := i
+		if i >= len(metadata.Sources) {
+			dependency := i - len(metadata.Sources)
+			root = -1
+			if dependency < len(metadata.DependencyRoots) {
+				root = metadata.DependencyRoots[dependency]
+			}
+		}
+		if sameViewIdentity(source.Table, metadata.TargetIdentity) {
+			markSourceInvalid(root, -1)
+			continue
+		}
+		switch {
+		case source.Snapshot == nil:
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "table.exists")
+		case !source.Snapshot.Exists || source.Snapshot.Temporary:
+			markSourceInvalid(root, -1)
+		case source.Snapshot.RelationKind == "":
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "relation.kind")
+		case source.Snapshot.RelationKind == "view" && (source.Snapshot.View == nil || source.Snapshot.View.Definition == nil):
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.definition")
+		case source.Snapshot.RelationKind == "view" && !source.Snapshot.View.Definition.SourcesKnown:
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+		}
+	}
+	if definition != nil && !definition.ShapeKnown && !shapeUnsupported && !(len(metadata.Sources) == 1 &&
+		metadata.Sources[0].Snapshot != nil &&
+		(!metadata.Sources[0].Snapshot.Exists || metadata.Sources[0].Snapshot.Temporary)) {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.columns")
+	}
+	assessBindings := func(definition *ViewDefinition, sources []TargetBinding) (int, []string) {
+		if definition == nil || !definition.ShapeKnown || len(sources) != 1 {
+			return -1, nil
+		}
+		identity := sources[0].Table
+		qualifier := identity.Name
+		if len(definition.SourceAliases) > 0 && definition.SourceAliases[0] != "" {
+			qualifier = definition.SourceAliases[0]
+		}
+		bindings := make([]ViewColumnBinding, 0, len(definition.Bindings)+len(definition.References))
+		bindings = append(bindings, definition.Bindings...)
+		bindings = append(bindings, definition.References...)
+		invalidQualifier := make([]bool, len(bindings))
+		invalid := -1
+		var required []string
+		for i, binding := range bindings {
+			if binding.Expression {
+				continue
+			}
+			if binding.Table != "" && !strings.EqualFold(binding.Table, qualifier) ||
+				binding.Schema != "" && !strings.EqualFold(binding.Schema, identity.Schema) {
+				invalidQualifier[i] = true
+				if invalid < 0 {
+					invalid = i
+				}
+			}
+		}
+		source := sources[0].Snapshot
+		if source != nil && source.Exists && !source.Temporary {
+			if source.Columns == nil {
+				for i, invalid := range invalidQualifier {
+					if !invalid && !bindings[i].Expression {
+						required = appendViewFact(required, "view.columns")
+						break
+					}
+				}
+			} else {
+				for i, binding := range bindings {
+					if invalidQualifier[i] {
+						continue
+					}
+					if binding.Expression {
+						continue
+					}
+					if binding.Star {
+						if source.ColumnsTailUnknown {
+							required = appendViewFact(required, "view.columns")
+						}
+						continue
+					}
+					if !source.HasColumn(binding.Column) {
+						if source.ColumnsTailUnknown {
+							required = appendViewFact(required, "view.columns")
+						} else if invalid < 0 {
+							invalid = i
+						}
+					}
+				}
+			}
+		}
+		return invalid, required
+	}
+	if definition != nil && definition.Query != nil && definition.ShapeKnown && !metadata.DependencyLimit {
+		queryAssessment := assessViewQuery(definition.Query, metadata.Sources, statement.Dialect)
+		for _, failure := range queryAssessment.failures {
+			markSourceOffset(failure.Root, -1, failure.Offset)
+		}
+		for _, fact := range queryAssessment.required {
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, fact)
+		}
+		assessment.DependencyLimit = assessment.DependencyLimit || queryAssessment.limited
+		outputs, countKnown := queryAssessment.outputs, queryAssessment.countKnown
+		if countKnown && len(ddl.View.Columns) > 0 {
+			if len(ddl.View.Columns) != len(outputs) {
+				markSourceInvalid(-1, -1)
+			} else {
+				outputs = append([]string(nil), ddl.View.Columns...)
+			}
+		}
+		if countKnown {
+			assessment.OutputNamesKnown = true
+			seen := make(map[string]struct{}, len(outputs))
+			for _, output := range outputs {
+				if output == "" {
+					assessment.OutputNamesKnown = false
+					continue
+				}
+				key := strings.ToLower(output)
+				if _, exists := seen[key]; exists {
+					markSourceInvalid(-1, -1)
+				}
+				seen[key] = struct{}{}
+			}
+			assessment.OutputNames = outputs
+		}
+	} else if definition != nil && definition.Query == nil {
+		invalid, required := assessBindings(definition, metadata.Sources)
+		if invalid >= 0 {
+			markSourceInvalid(0, invalid)
+		}
+		for _, fact := range required {
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, fact)
+		}
+	}
+	if definition != nil && definition.Query == nil && definition.ShapeKnown {
+		countKnown := true
+		var outputs []string
+		for _, binding := range definition.Bindings {
+			if !binding.Star {
+				outputs = append(outputs, binding.Output)
+				continue
+			}
+			if len(metadata.Sources) != 1 || metadata.Sources[0].Snapshot == nil ||
+				metadata.Sources[0].Snapshot.Columns == nil || metadata.Sources[0].Snapshot.ColumnsTailUnknown {
+				countKnown = false
+				break
+			}
+			for _, column := range metadata.Sources[0].Snapshot.Columns {
+				if !strings.EqualFold(column.Visibility, "invisible") {
+					outputs = append(outputs, column.Name)
+				}
+			}
+		}
+		if countKnown && len(ddl.View.Columns) > 0 {
+			if len(ddl.View.Columns) != len(outputs) {
+				markSourceInvalid(-1, -1)
+			} else {
+				outputs = append([]string(nil), ddl.View.Columns...)
+			}
+		}
+		if countKnown {
+			assessment.OutputNamesKnown = true
+			seen := make(map[string]struct{}, len(outputs))
+			for _, output := range outputs {
+				if output == "" {
+					assessment.OutputNamesKnown = false
+					continue
+				}
+				key := strings.ToLower(output)
+				if _, exists := seen[key]; exists {
+					markSourceInvalid(-1, -1)
+				}
+				seen[key] = struct{}{}
+			}
+			assessment.OutputNames = outputs
+		}
+	}
+	for _, dependency := range metadata.DependencyChecks {
+		if dependency.Definition != nil && dependency.Definition.Query != nil {
+			queryAssessment := assessViewQuery(dependency.Definition.Query, dependency.Sources, statement.Dialect)
+			if len(queryAssessment.failures) > 0 {
+				markSourceInvalid(dependency.Root, -1)
+			}
+			for _, fact := range queryAssessment.required {
+				assessment.SourceRequired = appendViewFact(assessment.SourceRequired, fact)
+			}
+			assessment.DependencyLimit = assessment.DependencyLimit || queryAssessment.limited
+			continue
+		}
+		invalid, required := assessBindings(dependency.Definition, dependency.Sources)
+		if invalid >= 0 {
+			markSourceInvalid(dependency.Root, -1)
+		}
+		for _, fact := range required {
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, fact)
+		}
+	}
+	return assessment
+}
+
+type viewTargetKind uint8
+
+const (
+	viewTargetUnknown viewTargetKind = iota
+	viewTargetMissing
+	viewTargetView
+	viewTargetTable
+	viewTargetUnknownKind
+	viewTargetNotView
+)
+
+func classifyViewTarget(binding TargetBinding) viewTargetKind {
+	if binding.Snapshot == nil {
+		if binding.NotView {
+			return viewTargetNotView
+		}
+		return viewTargetUnknown
+	}
+	if !binding.Snapshot.Exists {
+		return viewTargetMissing
+	}
+	switch binding.Snapshot.RelationKind {
+	case "view":
+		return viewTargetView
+	case "":
+		return viewTargetUnknownKind
+	default:
+		return viewTargetTable
+	}
+}
+
+func assessDropView(statement Statement, metadata *ViewMetadata) ViewLifecycleAssessment {
+	assessment := ViewLifecycleAssessment{SourceRootIndex: -1, SourceBindingIndex: -1}
+	targets := metadata.Targets
+	if len(targets) == 0 && statement.DDL.Table != nil {
+		targets = []TargetBinding{{Table: metadata.TargetIdentity, Snapshot: metadata.Target}}
+	}
+	ifExists := statement.DDL.Options["if_exists"] == "true"
+	kinds := make([]viewTargetKind, len(targets))
+	duplicates := make([]int, len(targets))
+	seen := make(map[Table]int, len(targets))
+	knownView, potentialBad, duplicateMySQL := false, false, false
+	for i, binding := range targets {
+		kinds[i] = classifyViewTarget(binding)
+		duplicates[i] = -1
+		key := Table{Schema: strings.ToLower(binding.Table.Schema), Name: strings.ToLower(binding.Table.Name)}
+		if previous, exists := seen[key]; exists {
+			duplicates[i] = previous
+			if statement.Dialect == DialectMySQL {
+				duplicateMySQL = true
+			}
+		} else {
+			seen[key] = i
+		}
+		knownView = knownView || kinds[i] == viewTargetView
+		potentialBad = potentialBad || kinds[i] != viewTargetView
+	}
+	unknownVersion := statement.Dialect == DialectMySQL &&
+		(statement.Metadata == nil || statement.Metadata.Version == nil || statement.Metadata.Version.Major == 0)
+	atomic := statement.Dialect == DialectMySQL && !unknownVersion && statement.Metadata.Version.Major >= 8
+	if statement.Dialect == DialectMySQL && unknownVersion && !ifExists && len(targets) > 1 &&
+		knownView && potentialBad && !duplicateMySQL {
+		assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "database.version")
+	}
+	tidbStopped, tidbMayStop := false, false
+	for i, binding := range targets {
+		kind := kinds[i]
+		if statement.Dialect == DialectTiDB && duplicates[i] >= 0 &&
+			assessment.DropTargets[duplicates[i]].Fate == ViewDropRemove {
+			kind = viewTargetMissing
+		}
+		target := ViewDropTarget{Binding: binding, Fate: ViewDropKeep}
+		switch {
+		case statement.Dialect == DialectMySQL && duplicates[i] >= 0:
+			target.Invalid = true
+		case kind == viewTargetMissing:
+			target.Invalid = !ifExists
+		case kind == viewTargetTable:
+			target.Invalid = !ifExists || statement.Dialect == DialectTiDB
+		case kind == viewTargetNotView && !ifExists:
+			target.Invalid = true
+		case kind == viewTargetUnknown:
+			if !ifExists || statement.Dialect == DialectTiDB {
+				assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "table.exists")
+			}
+		case kind == viewTargetUnknownKind || kind == viewTargetNotView:
+			if !ifExists || statement.Dialect == DialectTiDB {
+				fact := "relation.kind"
+				if kind == viewTargetNotView {
+					fact = "table.exists"
+				}
+				assessment.TargetRequired = appendViewFact(assessment.TargetRequired, fact)
+			}
+		}
+		assessment.TargetInvalid = assessment.TargetInvalid || target.Invalid
+		switch statement.Dialect {
+		case DialectTiDB:
+			switch {
+			case tidbStopped:
+				target.Fate = ViewDropKeep
+			case tidbMayStop:
+				if kind == viewTargetView || kind == viewTargetUnknown || kind == viewTargetUnknownKind {
+					target.Fate = ViewDropUnknown
+				}
+				if kind == viewTargetTable {
+					tidbStopped = true
+					tidbMayStop = false
+				}
+			default:
+				switch kind {
+				case viewTargetView:
+					target.Fate = ViewDropRemove
+				case viewTargetTable:
+					tidbStopped = true
+				case viewTargetUnknown, viewTargetUnknownKind, viewTargetNotView:
+					target.Fate = ViewDropNotView
+					tidbMayStop = true
+				}
+			}
+		case DialectMySQL:
+			switch {
+			case duplicateMySQL:
+				target.Fate = ViewDropKeep
+			case ifExists:
+				if kind == viewTargetView {
+					target.Fate = ViewDropRemove
+				} else if kind == viewTargetUnknown || kind == viewTargetUnknownKind {
+					target.Fate = ViewDropNotView
+				}
+			case !unknownVersion && !atomic:
+				if kind == viewTargetView {
+					target.Fate = ViewDropRemove
+				} else if kind == viewTargetUnknown || kind == viewTargetUnknownKind {
+					target.Fate = ViewDropNotView
+				}
+			case potentialBad:
+				if atomic && hasKnownInvalidDropTarget(kinds) {
+					target.Fate = ViewDropKeep
+				} else if kind == viewTargetView || kind == viewTargetUnknown || kind == viewTargetUnknownKind {
+					target.Fate = ViewDropUnknown
+				}
+			case kind == viewTargetView:
+				target.Fate = ViewDropRemove
+			}
+		}
+		assessment.DropTargets = append(assessment.DropTargets, target)
+	}
+	return assessment
+}
+
+func hasKnownInvalidDropTarget(kinds []viewTargetKind) bool {
+	for _, kind := range kinds {
+		if kind == viewTargetMissing || kind == viewTargetTable || kind == viewTargetNotView {
+			return true
+		}
+	}
+	return false
+}
+
+func CloneViewDefinition(in *ViewDefinition) *ViewDefinition {
+	if in == nil {
+		return nil
+	}
+	out := *in
+	if in.Sources != nil {
+		out.Sources = append([]Table{}, in.Sources...)
+	}
+	if in.SourceAliases != nil {
+		out.SourceAliases = append([]string{}, in.SourceAliases...)
+	}
+	if in.SourceOffsets != nil {
+		out.SourceOffsets = append([]int{}, in.SourceOffsets...)
+	}
+	if in.Bindings != nil {
+		out.Bindings = append([]ViewColumnBinding{}, in.Bindings...)
+	}
+	if in.References != nil {
+		out.References = append([]ViewColumnBinding{}, in.References...)
+	}
+	out.Query = cloneViewQuery(in.Query, make(map[*ViewQuery]*ViewQuery))
+	return &out
+}
+
+func cloneViewQuery(in *ViewQuery, copies map[*ViewQuery]*ViewQuery) *ViewQuery {
+	if in == nil {
+		return nil
+	}
+	if prior := copies[in]; prior != nil {
+		return prior
+	}
+	out := *in
+	copies[in] = &out
+	out.Bindings = append([]ViewColumnBinding(nil), in.Bindings...)
+	out.References = append([]ViewColumnBinding(nil), in.References...)
+	out.ColumnAliases = append([]string(nil), in.ColumnAliases...)
+	out.Sources = append([]ViewQuerySource(nil), in.Sources...)
+	for i := range out.Sources {
+		if in.Sources[i].Table != nil {
+			table := *in.Sources[i].Table
+			out.Sources[i].Table = &table
+		}
+		out.Sources[i].Query = cloneViewQuery(in.Sources[i].Query, copies)
+	}
+	cloneList := func(in []*ViewQuery) []*ViewQuery {
+		out := make([]*ViewQuery, len(in))
+		for i, query := range in {
+			out[i] = cloneViewQuery(query, copies)
+		}
+		return out
+	}
+	out.With = cloneList(in.With)
+	out.Subqueries = cloneList(in.Subqueries)
+	out.SetOperands = cloneList(in.SetOperands)
+	return &out
+}
+
+func SelectViewDefinition(in *ViewDefinition, dialect Dialect) *ViewDefinition {
+	out := CloneViewDefinition(in)
+	if out == nil || out.Query == nil {
+		return out
+	}
+	out.Sources = nil
+	out.SourceAliases = nil
+	out.SourceOffsets = nil
+	out.QueryLimit = false
+	visited := make(map[*ViewQuery]bool)
+	var visit func(*ViewQuery)
+	visit = func(query *ViewQuery) {
+		if query == nil || visited[query] || len(out.Sources) > 256 {
+			return
+		}
+		visited[query] = true
+		if query.Limited {
+			out.QueryLimit = true
+		}
+		if query.Unsupported {
+			out.ShapeKnown = false
+		}
+		if dialect == DialectTiDB {
+			for _, body := range query.With {
+				visit(body)
+			}
+		}
+		for i := range query.Sources {
+			if len(out.Sources) > 256 {
+				break
+			}
+			source := &query.Sources[i]
+			if source.Table != nil {
+				source.Index = len(out.Sources)
+				out.Sources = append(out.Sources, *source.Table)
+				out.SourceAliases = append(out.SourceAliases, source.Alias)
+				out.SourceOffsets = append(out.SourceOffsets, source.Offset)
+			}
+			visit(source.Query)
+		}
+		for _, operand := range query.SetOperands {
+			visit(operand)
+		}
+		for _, subquery := range query.Subqueries {
+			visit(subquery)
+		}
+	}
+	visit(out.Query)
+	return out
+}
+
+func BindViewDefinitionSources(definition *ViewDefinition, sources []TargetBinding) {
+	if definition == nil || definition.Query == nil {
+		return
+	}
+	seen := make(map[*ViewQuery]bool)
+	var visit func(*ViewQuery)
+	visit = func(query *ViewQuery) {
+		if query == nil || seen[query] {
+			return
+		}
+		seen[query] = true
+		for i := range query.Sources {
+			source := &query.Sources[i]
+			if source.Table != nil && source.Index >= 0 && source.Index < len(sources) {
+				table := sources[source.Index].Table
+				source.Table = &table
+			}
+			visit(source.Query)
+		}
+		for _, child := range query.With {
+			visit(child)
+		}
+		for _, child := range query.SetOperands {
+			visit(child)
+		}
+		for _, child := range query.Subqueries {
+			visit(child)
+		}
+	}
+	visit(definition.Query)
+}
+
+func CloneViewSnapshot(in *ViewSnapshot) *ViewSnapshot {
+	if in == nil {
+		return nil
+	}
+	out := *in
+	out.Definition = CloneViewDefinition(in.Definition)
+	if in.Updatable != nil {
+		value := *in.Updatable
+		out.Updatable = &value
+	}
+	return &out
+}
diff --git a/internal/domain/spec/view_query.go b/internal/domain/spec/view_query.go
new file mode 100644
index 00000000..04ec4699
--- /dev/null
+++ b/internal/domain/spec/view_query.go
@@ -0,0 +1,317 @@
+package spec
+
+import "strings"
+
+type viewQueryResult struct {
+	outputs    []string
+	countKnown bool
+}
+
+type viewQueryAssessment struct {
+	outputs    []string
+	countKnown bool
+	failures   []ViewSourceFailure
+	required   []string
+	limited    bool
+}
+
+type viewQueryRelation struct {
+	identity       Table
+	alias          string
+	columns        []Column
+	columnsKnown   bool
+	columnsUnknown bool
+	missing        bool
+	root           int
+}
+
+type viewQueryEvaluator struct {
+	sources []TargetBinding
+	dialect Dialect
+	result  viewQueryAssessment
+	active  map[*ViewQuery]bool
+	visits  int
+	freeze  bool
+}
+
+func assessViewQuery(query *ViewQuery, sources []TargetBinding, dialect Dialect) viewQueryAssessment {
+	evaluator := &viewQueryEvaluator{sources: sources, dialect: dialect, active: make(map[*ViewQuery]bool)}
+	result := evaluator.evaluate(query, nil, 0)
+	evaluator.result.outputs = result.outputs
+	evaluator.result.countKnown = result.countKnown
+	return evaluator.result
+}
+
+func FreezeViewDefinition(in *ViewDefinition, sources []TargetBinding, dialect Dialect) *ViewDefinition {
+	out := CloneViewDefinition(in)
+	if out == nil || out.Query == nil {
+		return out
+	}
+	evaluator := &viewQueryEvaluator{
+		sources: sources, dialect: dialect, active: make(map[*ViewQuery]bool), freeze: true,
+	}
+	evaluator.evaluate(out.Query, nil, 0)
+	return out
+}
+
+func (e *viewQueryEvaluator) invalid(root, offset int) {
+	for _, failure := range e.result.failures {
+		if failure.Root == root {
+			return
+		}
+	}
+	e.result.failures = append(e.result.failures, ViewSourceFailure{Root: root, Offset: offset})
+}
+
+func (e *viewQueryEvaluator) require(fact string) {
+	e.result.required = appendViewFact(e.result.required, fact)
+}
+
+func (e *viewQueryEvaluator) evaluate(query *ViewQuery, outer []viewQueryRelation, depth int) viewQueryResult {
+	if query == nil {
+		return viewQueryResult{}
+	}
+	e.visits++
+	if depth > 32 || e.visits > 1024 || query.Limited || e.active[query] {
+		e.result.limited = true
+		return viewQueryResult{}
+	}
+	e.active[query] = true
+	defer delete(e.active, query)
+	if e.dialect == DialectTiDB {
+		for _, body := range query.With {
+			e.evaluate(body, nil, depth+1)
+		}
+	}
+	if len(query.SetOperands) > 0 {
+		var result viewQueryResult
+		for i, operand := range query.SetOperands {
+			next := e.evaluate(operand, outer, depth+1)
+			if i == 0 {
+				result = next
+			} else if result.countKnown && next.countKnown && len(result.outputs) != len(next.outputs) {
+				e.invalid(viewQueryFirstRoot(operand), -1)
+			} else if !next.countKnown {
+				result.countKnown = false
+			}
+		}
+		return e.renameOutputs(query, result)
+	}
+	relations := make([]viewQueryRelation, 0, len(query.Sources))
+	for _, source := range query.Sources {
+		relation := viewQueryRelation{alias: source.Alias, root: source.Index}
+		if source.Table != nil {
+			relation.identity = *source.Table
+			if source.Index < 0 || source.Index >= len(e.sources) {
+				relations = append(relations, relation)
+				continue
+			}
+			binding := e.sources[source.Index]
+			relation.identity = binding.Table
+			snapshot := binding.Snapshot
+			if snapshot == nil {
+				relations = append(relations, relation)
+				continue
+			}
+			if !snapshot.Exists || snapshot.Temporary {
+				relation.missing = true
+			} else if snapshot.Columns == nil || snapshot.ColumnsTailUnknown {
+				relation.columnsUnknown = true
+			} else {
+				relation.columnsKnown = true
+				relation.columns = snapshot.Columns
+			}
+		} else if source.Query != nil {
+			child := e.evaluate(source.Query, nil, depth+1)
+			relation.root = viewQueryFirstRoot(source.Query)
+			if child.countKnown {
+				relation.columnsKnown = true
+				for _, name := range child.outputs {
+					if name == "" {
+						relation.columnsKnown = false
+						relation.columnsUnknown = true
+					}
+					relation.columns = append(relation.columns, Column{Name: name})
+				}
+			}
+		}
+		relations = append(relations, relation)
+	}
+	for _, binding := range query.References {
+		e.resolveColumn(binding, relations, outer, query.Bindings)
+	}
+	result := viewQueryResult{countKnown: true}
+	var frozen []ViewColumnBinding
+	for _, binding := range query.Bindings {
+		switch {
+		case binding.Star:
+			columns, expanded, known := e.expandStar(binding, relations)
+			result.outputs = append(result.outputs, columns...)
+			result.countKnown = result.countKnown && known
+			if known {
+				frozen = append(frozen, expanded...)
+			} else {
+				frozen = append(frozen, binding)
+			}
+		case binding.Expression:
+			result.outputs = append(result.outputs, binding.Output)
+			frozen = append(frozen, binding)
+		default:
+			e.resolveColumn(binding, relations, outer, nil)
+			result.outputs = append(result.outputs, binding.Output)
+			frozen = append(frozen, binding)
+		}
+	}
+	if e.freeze {
+		query.Bindings = frozen
+	}
+	correlated := append(append([]viewQueryRelation(nil), relations...), outer...)
+	for _, subquery := range query.Subqueries {
+		e.evaluate(subquery, correlated, depth+1)
+	}
+	return e.renameOutputs(query, result)
+}
+
+func (e *viewQueryEvaluator) renameOutputs(query *ViewQuery, result viewQueryResult) viewQueryResult {
+	if result.countKnown && len(query.ColumnAliases) > 0 {
+		if len(query.ColumnAliases) != len(result.outputs) {
+			e.invalid(viewQueryFirstRoot(query), -1)
+			return result
+		}
+		result.outputs = append([]string(nil), query.ColumnAliases...)
+	}
+	return result
+}
+
+func viewQueryFirstRoot(query *ViewQuery) int {
+	if query == nil {
+		return -1
+	}
+	for _, source := range query.Sources {
+		if source.Table != nil {
+			return source.Index
+		}
+		if root := viewQueryFirstRoot(source.Query); root >= 0 {
+			return root
+		}
+	}
+	for _, operand := range query.SetOperands {
+		if root := viewQueryFirstRoot(operand); root >= 0 {
+			return root
+		}
+	}
+	return -1
+}
+
+func viewQueryMatches(binding ViewColumnBinding, relation viewQueryRelation) bool {
+	qualifier := relation.identity.Name
+	if relation.alias != "" {
+		qualifier = relation.alias
+	}
+	if binding.Table != "" && !strings.EqualFold(binding.Table, qualifier) {
+		return false
+	}
+	if binding.Schema != "" && !strings.EqualFold(binding.Schema, relation.identity.Schema) {
+		return false
+	}
+	return true
+}
+
+func (e *viewQueryEvaluator) resolveColumn(binding ViewColumnBinding, local, outer []viewQueryRelation, outputs []ViewColumnBinding) {
+	if binding.Expression || binding.Star {
+		return
+	}
+	matched := 0
+	firstRoot := -1
+	unknown, unknownColumns, missing, qualified := false, false, false, false
+	for _, relation := range local {
+		if !viewQueryMatches(binding, relation) {
+			continue
+		}
+		qualified = true
+		if firstRoot < 0 {
+			firstRoot = relation.root
+		}
+		switch {
+		case relation.missing:
+			missing = true
+		case !relation.columnsKnown:
+			unknown = true
+			unknownColumns = unknownColumns || relation.columnsUnknown
+		default:
+			for _, column := range relation.columns {
+				if strings.EqualFold(column.Name, binding.Column) {
+					matched++
+					break
+				}
+			}
+		}
+	}
+	if matched > 1 {
+		e.invalid(firstRoot, binding.Offset)
+		return
+	}
+	if unknownColumns {
+		e.require("view.columns")
+	}
+	if matched == 1 || unknown || missing {
+		return
+	}
+	if binding.OutputReference && binding.Table == "" && binding.Schema == "" {
+		for _, output := range outputs {
+			if output.Output != "" && strings.EqualFold(output.Output, binding.Column) {
+				return
+			}
+		}
+	}
+	if (!qualified || binding.Table == "" && binding.Schema == "") && len(outer) > 0 {
+		e.resolveColumn(binding, outer, nil, outputs)
+		return
+	}
+	if firstRoot < 0 && len(local) > 0 {
+		firstRoot = local[0].root
+	}
+	e.invalid(firstRoot, binding.Offset)
+}
+
+func (e *viewQueryEvaluator) expandStar(binding ViewColumnBinding, relations []viewQueryRelation) ([]string, []ViewColumnBinding, bool) {
+	var names []string
+	var expanded []ViewColumnBinding
+	countKnown := true
+	matched := 0
+	firstRoot := -1
+	for _, relation := range relations {
+		if !viewQueryMatches(binding, relation) {
+			continue
+		}
+		matched++
+		if firstRoot < 0 {
+			firstRoot = relation.root
+		}
+		if !relation.columnsKnown {
+			countKnown = false
+			if relation.columnsUnknown {
+				e.require("view.columns")
+			}
+			continue
+		}
+		for _, column := range relation.columns {
+			if !strings.EqualFold(column.Visibility, "invisible") {
+				names = append(names, column.Name)
+				qualifier := relation.identity.Name
+				if relation.alias != "" {
+					qualifier = relation.alias
+				}
+				expanded = append(expanded, ViewColumnBinding{Table: qualifier, Column: column.Name, Output: column.Name, Offset: binding.Offset})
+			}
+		}
+	}
+	if matched == 0 || binding.Table != "" && matched > 1 {
+		if firstRoot < 0 && len(relations) > 0 {
+			firstRoot = relations[0].root
+		}
+		e.invalid(firstRoot, binding.Offset)
+		countKnown = false
+	}
+	return names, expanded, countKnown
+}
diff --git a/internal/infrastructure/metadata/mysql/provider_t18_first_test.go b/internal/infrastructure/metadata/mysql/provider_t18_first_test.go
new file mode 100644
index 00000000..d090f207
--- /dev/null
+++ b/internal/infrastructure/metadata/mysql/provider_t18_first_test.go
@@ -0,0 +1,88 @@
+package mysqlmeta
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+)
+
+func t18ViewRows(view testQueryResult) map[string]testQueryResult {
+	return map[string]testQueryResult{
+		"from information_schema.tables": {
+			columns: []string{"engine", "table_collation", "table_comment", "auto_increment", "row_format", "table_rows", "table_type"},
+			rows:    [][]driver.Value{{nil, nil, "VIEW", nil, nil, nil, "VIEW"}},
+		},
+		"from information_schema.columns": {
+			columns: []string{"column_name", "column_type", "character_set_name", "collation_name", "column_comment", "column_default", "is_nullable", "extra", "generation_expression"},
+			rows:    [][]driver.Value{{"id", "int", nil, nil, "", nil, "YES", "", ""}},
+		},
+		"from information_schema.views": view,
+	}
+}
+
+func TestT18FirstViewCatalogFacts(t *testing.T) {
+	rows := testQueryResult{
+		columns: []string{"view_definition", "security_type", "check_option", "is_updatable", "definer"},
+		rows:    [][]driver.Value{{"SELECT `g`.`u`.`id` AS `id` FROM `g`.`u`", "DEFINER", "NONE", "YES", "t18_private_principal@host"}},
+	}
+	snapshot, err := NewProvider(openTestDB(t, t18ViewRows(rows))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if err != nil || snapshot == nil || !snapshot.Exists || snapshot.RelationKind != "view" || snapshot.View == nil ||
+		snapshot.View.Security != "definer" || snapshot.View.CheckOption != "none" ||
+		snapshot.View.Updatable == nil || !*snapshot.View.Updatable || snapshot.View.Definition == nil ||
+		!snapshot.View.Definition.SourcesKnown || len(snapshot.View.Definition.Sources) != 1 ||
+		snapshot.View.Definition.Sources[0] != (spec.Table{Schema: "g", Name: "u"}) {
+		t.Fatalf("snapshot=%#v err=%v", snapshot, err)
+	}
+	encoded, err := json.Marshal(snapshot)
+	if err != nil || strings.Contains(string(encoded), "t18_private_principal") || strings.Contains(string(encoded), "SELECT") {
+		t.Fatalf("snapshot JSON=%s err=%v", encoded, err)
+	}
+}
+
+func TestT18FirstViewCatalogNullAndError(t *testing.T) {
+	row := testQueryResult{
+		columns: []string{"view_definition", "security_type", "check_option", "is_updatable", "definer"},
+		rows:    [][]driver.Value{{nil, "DEFINER", "NONE", nil, nil}},
+	}
+	snapshot, err := NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if err != nil || snapshot == nil || !snapshot.Exists || snapshot.View == nil || snapshot.View.Definition != nil {
+		t.Fatalf("snapshot=%#v err=%v", snapshot, err)
+	}
+	row.rows = nil
+	snapshot, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if err != nil || snapshot == nil || !snapshot.Exists || snapshot.RelationKind != "view" ||
+		snapshot.View == nil || snapshot.View.Definition != nil {
+		t.Fatalf("missing attributes must remain unknown: snapshot=%#v err=%v", snapshot, err)
+	}
+	cause := errors.New("t18_private_driver_error")
+	row = testQueryResult{queryErr: cause}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, cause) || strings.Contains(err.Error(), "t18_private_driver_error") {
+		t.Fatalf("unbounded or lost error: %v", err)
+	}
+	row = testQueryResult{queryErr: sql.ErrNoRows}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, sql.ErrNoRows) {
+		t.Fatalf("driver error was treated as an empty result: %v", err)
+	}
+	row = testQueryResult{
+		columns:  []string{"view_definition", "security_type", "check_option", "is_updatable", "definer"},
+		rows:     [][]driver.Value{{"SELECT id FROM t", "DEFINER", "NONE", "YES", "private"}},
+		rowErrAt: 1, rowErr: cause,
+	}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, cause) || strings.Contains(err.Error(), "t18_private_driver_error") {
+		t.Fatalf("unbounded or lost iteration error: %v", err)
+	}
+	row = testQueryResult{queryErr: context.DeadlineExceeded}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("provider timeout was lost: %v", err)
+	}
+}
diff --git a/internal/infrastructure/parser/tidb/view.go b/internal/infrastructure/parser/tidb/view.go
new file mode 100644
index 00000000..251fbf23
--- /dev/null
+++ b/internal/infrastructure/parser/tidb/view.go
@@ -0,0 +1,573 @@
+package tidbparser
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+	"github.com/pingcap/tidb/pkg/parser"
+	"github.com/pingcap/tidb/pkg/parser/ast"
+	"github.com/pingcap/tidb/pkg/parser/charset"
+	"github.com/pingcap/tidb/pkg/parser/format"
+)
+
+type viewStatement struct {
+	ast.StmtNode
+	operation   spec.DDLOperation
+	target      spec.Table
+	declaration *spec.ViewDeclaration
+}
+
+type viewHeader struct {
+	operation   spec.DDLOperation
+	target      spec.Table
+	declaration *spec.ViewDeclaration
+	selectStart int
+	selectEnd   int
+}
+
+func unmodeledViewOptions(view *spec.ViewDeclaration) []string {
+	var options []string
+	if view.Definition == nil || !view.Definition.ShapeKnown || !view.Definition.SourcesKnown {
+		options = append(options, "view_query_shape")
+	} else if len(view.Columns) == 0 {
+		unnamed := 0
+		for _, binding := range view.Definition.Bindings {
+			if !binding.Star && binding.Output == "" {
+				unnamed++
+			}
+		}
+		if view.Definition.UnlabeledComplex || unnamed > 0 && len(view.Definition.Bindings) > 1 {
+			options = append(options, "view_output_label")
+		}
+	}
+	return options
+}
+
+func parseViewIdentifier(text string, components int) (string, string, bool) {
+	nodes, _, err := parser.New().Parse("SELECT "+text, "", "")
+	if err != nil || len(nodes) != 1 {
+		return "", "", false
+	}
+	query, ok := nodes[0].(*ast.SelectStmt)
+	if !ok || query.Fields == nil || len(query.Fields.Fields) != 1 || query.From != nil {
+		return "", "", false
+	}
+	field := query.Fields.Fields[0]
+	column, ok := field.Expr.(*ast.ColumnNameExpr)
+	if !ok || column.Name == nil || field.AsName.L != "" || column.Name.Schema.L != "" || column.Name.Name.L == "" {
+		return "", "", false
+	}
+	if components == 1 && column.Name.Table.L == "" {
+		return "", column.Name.Name.L, true
+	}
+	if components == 2 && column.Name.Table.L != "" {
+		return column.Name.Table.L, column.Name.Name.L, true
+	}
+	return "", "", false
+}
+
+func parseViewDefiner(text string) bool {
+	nodes, _, err := parser.New().Parse("SHOW GRANTS FOR "+text, "", "")
+	if err != nil || len(nodes) != 1 {
+		return false
+	}
+	show, ok := nodes[0].(*ast.ShowStmt)
+	return ok && show.Tp == ast.ShowGrants && show.User != nil && len(show.Roles) == 0 &&
+		show.Where == nil && show.Pattern == nil && show.Limit == nil
+}
+
+func viewDropTargetOffsets(sql string) []int {
+	tokens := tokenizeSQL(sql)
+	i := 0
+	for i < len(tokens) && !tokens[i].wordIs(sql, "VIEW") {
+		i++
+	}
+	i++
+	if i < len(tokens) && tokens[i].wordIs(sql, "IF") {
+		i += 2
+	}
+	var offsets []int
+	for i < len(tokens) && tokens[i].text(sql) != ";" {
+		offsets = append(offsets, tokens[i].start)
+		for i < len(tokens) && tokens[i].text(sql) != "," && tokens[i].text(sql) != ";" {
+			i++
+		}
+		if i < len(tokens) && tokens[i].text(sql) == "," {
+			i++
+		}
+	}
+	return offsets
+}
+
+func parseViewHeader(sql string) (*viewHeader, bool) {
+	tokens := tokenizeSQL(sql)
+	if len(tokens) < 5 {
+		return nil, false
+	}
+	i := 0
+	take := func(word string) bool {
+		if i < len(tokens) && tokens[i].wordIs(sql, word) {
+			i++
+			return true
+		}
+		return false
+	}
+	punct := func(value string) bool {
+		if i < len(tokens) && tokens[i].kind == tokPunct && tokens[i].text(sql) == value {
+			i++
+			return true
+		}
+		return false
+	}
+	identifierToken := func() (sqlTok, bool) {
+		if i >= len(tokens) || (tokens[i].kind != tokWord && tokens[i].kind != tokQIdent) {
+			return sqlTok{}, false
+		}
+		token := tokens[i]
+		raw := token.text(sql)
+		if token.kind == tokQIdent && (len(raw) < 2 || raw[len(raw)-1] != '`') {
+			return sqlTok{}, false
+		}
+		i++
+		return token, true
+	}
+	h := &viewHeader{declaration: &spec.ViewDeclaration{}}
+	switch {
+	case take("ALTER"):
+		h.operation = spec.DDLOperationAlterView
+	case take("CREATE"):
+		h.operation = spec.DDLOperationCreateView
+		if take("OR") {
+			if !take("REPLACE") {
+				return nil, false
+			}
+			h.declaration.OrReplace = true
+		}
+	default:
+		return nil, false
+	}
+	if i < len(tokens) && tokens[i].wordIs(sql, "ALGORITHM") {
+		h.declaration.AlgorithmOffset = tokens[i].start
+	}
+	if take("ALGORITHM") {
+		if !punct("=") {
+			return nil, false
+		}
+		switch {
+		case take("UNDEFINED"):
+			h.declaration.Algorithm = "undefined"
+		case take("MERGE"):
+			h.declaration.Algorithm = "merge"
+		case take("TEMPTABLE"):
+			h.declaration.Algorithm = "temptable"
+		default:
+			return nil, false
+		}
+		h.declaration.AlgorithmExplicit = true
+	}
+	if i < len(tokens) && tokens[i].wordIs(sql, "DEFINER") {
+		h.declaration.DefinerOffset = tokens[i].start
+	}
+	if take("DEFINER") {
+		if !punct("=") || i >= len(tokens) {
+			return nil, false
+		}
+		if take("CURRENT_USER") {
+			h.declaration.DefinerKind = "current_user"
+			if punct("(") && !punct(")") {
+				return nil, false
+			}
+		} else {
+			start := tokens[i].start
+			for i < len(tokens) && !tokens[i].wordIs(sql, "VIEW") && !tokens[i].wordIs(sql, "SQL") {
+				i++
+			}
+			if i == 0 || tokens[i-1].end <= start {
+				return nil, false
+			}
+			end := tokens[i-1].end
+			if !parseViewDefiner(sql[start:end]) {
+				return nil, false
+			}
+			h.declaration.DefinerKind = "named"
+			h.declaration.DefinerPrincipal = sql[start:end]
+		}
+	}
+	if i < len(tokens) && tokens[i].wordIs(sql, "SQL") {
+		h.declaration.SecurityOffset = tokens[i].start
+	}
+	if take("SQL") {
+		if !take("SECURITY") {
+			return nil, false
+		}
+		switch {
+		case take("DEFINER"):
+			h.declaration.Security = "definer"
+		case take("INVOKER"):
+			h.declaration.Security = "invoker"
+		default:
+			return nil, false
+		}
+		h.declaration.SecurityExplicit = true
+	}
+	if !take("VIEW") {
+		return nil, false
+	}
+	first, valid := identifierToken()
+	if !valid {
+		return nil, false
+	}
+	if punct(".") {
+		second, ok := identifierToken()
+		if !ok {
+			return nil, false
+		}
+		h.target.Schema, h.target.Name, valid = parseViewIdentifier(sql[first.start:second.end], 2)
+	} else {
+		_, h.target.Name, valid = parseViewIdentifier(first.text(sql), 1)
+	}
+	if !valid {
+		return nil, false
+	}
+	if punct("(") {
+		for {
+			token, ok := identifierToken()
+			if !ok {
+				return nil, false
+			}
+			_, name, ok := parseViewIdentifier(token.text(sql), 1)
+			if !ok {
+				return nil, false
+			}
+			h.declaration.Columns = append(h.declaration.Columns, name)
+			if punct(")") {
+				break
+			}
+			if !punct(",") {
+				return nil, false
+			}
+		}
+	}
+	if !take("AS") || i >= len(tokens) {
+		return nil, false
+	}
+	h.selectStart = tokens[i].start
+	end := len(tokens)
+	if end > i && tokens[end-1].text(sql) == ";" {
+		end--
+	}
+	for j := i; j < end; j++ {
+		if tokens[j].kind == tokPunct && tokens[j].text(sql) == ";" {
+			return nil, false
+		}
+	}
+	if end <= i {
+		return nil, false
+	}
+	h.selectEnd = tokens[end-1].end
+	checkStart := end - 3
+	if end-i >= 3 && tokens[end-1].wordIs(sql, "OPTION") && tokens[end-2].wordIs(sql, "CHECK") {
+		if checkStart > i && (tokens[checkStart].wordIs(sql, "LOCAL") || tokens[checkStart].wordIs(sql, "CASCADED")) {
+			h.declaration.CheckOption = strings.ToLower(tokens[checkStart].text(sql))
+			checkStart--
+		} else {
+			h.declaration.CheckOption = "cascaded"
+			h.declaration.CheckBare = true
+		}
+		if checkStart <= i || !tokens[checkStart].wordIs(sql, "WITH") {
+			return nil, false
+		}
+		h.declaration.CheckExplicit = true
+		h.declaration.CheckOffset = tokens[checkStart].start
+		h.selectEnd = tokens[checkStart].start
+	}
+	return h, true
+}
+
+func parseViewQuery(ctx context.Context, sql string) (ast.StmtNode, []error, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, nil, err
+	}
+	nodes, warnings, err := parser.New().Parse(sql, "", "")
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(nodes) != 1 {
+		return nil, nil, fmt.Errorf("view definition must contain one query")
+	}
+	if _, ok := nodes[0].(ast.ResultSetNode); !ok {
+		return nil, nil, fmt.Errorf("view definition is not a query")
+	}
+	if selectNode, ok := nodes[0].(*ast.SelectStmt); ok && selectNode.SelectIntoOpt != nil {
+		return nil, nil, fmt.Errorf("view definition is not a query")
+	}
+	return nodes[0], warnings, nil
+}
+
+func viewDefinition(node ast.StmtNode, sql string, selectStart, offsetBase int, locations bool) *spec.ViewDefinition {
+	query, ok := node.(ast.ResultSetNode)
+	if !ok {
+		return nil
+	}
+	if needsViewQuery(query) {
+		builder := &viewQueryBuilder{
+			sql: sql, selectStart: selectStart, offsetBase: offsetBase, locations: locations,
+			usedOffsets: make(map[int]bool),
+		}
+		root := builder.build(query, nil, 0)
+		definition := &spec.ViewDefinition{
+			Query: root, HasCTE: builder.hasCTE, SourcesKnown: true, ShapeKnown: !root.Unsupported,
+			Bindings:         append([]spec.ViewColumnBinding(nil), root.Bindings...),
+			References:       append([]spec.ViewColumnBinding(nil), root.References...),
+			UnlabeledComplex: root.Unlabeled, NonMergeable: root.NonMergeable, NonUpdatable: root.NonUpdatable,
+		}
+		var restored strings.Builder
+		if err := node.Restore(format.NewRestoreCtx(format.DefaultRestoreFlags, &restored)); err == nil {
+			definition.SQL = restored.String()
+		}
+		return spec.SelectViewDefinition(definition, spec.DialectMySQL)
+	}
+	facts := analyzeQueryNode(query, newScopeStack(""))
+	ctes := make(map[string]bool)
+	for _, relation := range facts.relations {
+		if relation.Kind == "cte" {
+			ctes[strings.ToLower(relation.Name)] = true
+		}
+	}
+	definition := &spec.ViewDefinition{SourcesKnown: len(ctes) == 0}
+	for _, source := range selectSourceTables(query) {
+		if source.Schema == "" && ctes[strings.ToLower(source.Name)] {
+			continue
+		}
+		definition.Sources = append(definition.Sources, source)
+	}
+	definition.SourceAliases = make([]string, len(definition.Sources))
+	if locations {
+		definition.SourceOffsets = make([]int, len(definition.Sources))
+		for i := range definition.SourceOffsets {
+			definition.SourceOffsets[i] = -1
+		}
+	}
+	var restored strings.Builder
+	if err := node.Restore(format.NewRestoreCtx(format.DefaultRestoreFlags, &restored)); err == nil {
+		definition.SQL = restored.String()
+	}
+	selectNode, ok := node.(*ast.SelectStmt)
+	if !ok || selectNode.Fields == nil {
+		return definition
+	}
+	if selectNode.From != nil {
+		if selectNode.From.TableRefs == nil || selectNode.From.TableRefs.Right != nil {
+			return definition
+		}
+		source, ok := selectNode.From.TableRefs.Left.(*ast.TableSource)
+		if !ok {
+			return definition
+		}
+		if _, ok := source.Source.(*ast.TableName); !ok {
+			return definition
+		}
+		if len(definition.Sources) == 1 {
+			definition.SourceAliases[0] = source.AsName.L
+		}
+		if locations && len(definition.Sources) == 1 {
+			tokens := tokenizeSQL(sql)
+			depth := 0
+			for i, token := range tokens {
+				if token.start < selectStart {
+					continue
+				}
+				switch token.text(sql) {
+				case "(":
+					depth++
+				case ")":
+					depth--
+				}
+				if depth == 0 && token.wordIs(sql, "FROM") && i+1 < len(tokens) {
+					definition.SourceOffsets[0] = tokens[i+1].start
+					break
+				}
+			}
+		}
+	} else if len(definition.Sources) != 0 {
+		return definition
+	}
+	if selectNode.From == nil {
+		definition.NonMergeable = true
+		definition.NonUpdatable = true
+	}
+	if selectNode.With != nil || selectNode.GroupBy != nil ||
+		selectNode.Having != nil || selectNode.LockInfo != nil || selectNode.SelectIntoOpt != nil ||
+		selectNode.Distinct || len(selectNode.WindowSpecs) != 0 {
+		return definition
+	}
+	definition.ShapeKnown = true
+	for _, field := range selectNode.Fields.Fields {
+		if field.WildCard != nil {
+			offset := -1
+			if locations && field.Offset >= 0 && offsetBase+field.Offset < len(sql) {
+				offset = offsetBase + field.Offset
+			}
+			definition.Bindings = append(definition.Bindings, spec.ViewColumnBinding{
+				Schema: field.WildCard.Schema.L, Table: field.WildCard.Table.L, Offset: offset, Star: true,
+			})
+			continue
+		}
+		offset := -1
+		if locations && field.Offset >= 0 && offsetBase+field.Offset < len(sql) {
+			offset = offsetBase + field.Offset
+		}
+		column, isColumn := field.Expr.(*ast.ColumnNameExpr)
+		if isColumn && column.Name != nil {
+			output := field.AsName.L
+			if output == "" {
+				output = column.Name.Name.L
+			}
+			definition.Bindings = append(definition.Bindings, spec.ViewColumnBinding{
+				Schema: column.Name.Schema.L, Table: column.Name.Table.L,
+				Column: column.Name.Name.L, Output: output, Offset: offset,
+			})
+			continue
+		}
+		if field.Expr == nil {
+			definition.ShapeKnown = false
+			break
+		}
+		collector := &viewReferenceCollector{}
+		field.Expr.Accept(collector)
+		if collector.unsupported {
+			definition.ShapeKnown = false
+			break
+		}
+		if collector.aggregate {
+			definition.NonMergeable = true
+			definition.NonUpdatable = true
+		}
+		for i := range collector.references {
+			collector.references[i].Offset = offset
+		}
+		definition.References = append(definition.References, collector.references...)
+		if field.AsName.L == "" {
+			if _, literal := field.Expr.(ast.ValueExpr); !literal {
+				definition.UnlabeledComplex = true
+			}
+		}
+		definition.Bindings = append(definition.Bindings, spec.ViewColumnBinding{
+			Output: field.AsName.L, Offset: offset, Expression: true,
+		})
+	}
+	if definition.ShapeKnown && selectNode.Where != nil {
+		collector := &viewReferenceCollector{sql: sql, start: selectStart, locations: locations}
+		selectNode.Where.Accept(collector)
+		if collector.unsupported {
+			definition.ShapeKnown = false
+		} else {
+			definition.References = append(definition.References, collector.references...)
+		}
+	}
+	return definition
+}
+
+type viewReferenceCollector struct {
+	sql         string
+	start       int
+	locations   bool
+	unsupported bool
+	aggregate   bool
+	references  []spec.ViewColumnBinding
+}
+
+func (c *viewReferenceCollector) Enter(node ast.Node) (ast.Node, bool) {
+	switch node := node.(type) {
+	case *ast.AggregateFuncExpr:
+		c.aggregate = true
+	case *ast.SubqueryExpr:
+		c.unsupported = true
+		return node, true
+	case *ast.ColumnNameExpr:
+		if node.Name != nil {
+			offset := -1
+			if c.locations {
+				offset = viewReferenceOffset(c.sql, c.start, node.Name)
+			}
+			c.references = append(c.references, spec.ViewColumnBinding{
+				Schema: node.Name.Schema.L, Table: node.Name.Table.L, Column: node.Name.Name.L, Offset: offset,
+			})
+		}
+		return node, true
+	}
+	return node, false
+}
+
+func (c *viewReferenceCollector) Leave(node ast.Node) (ast.Node, bool) { return node, true }
+
+func viewReferenceOffset(sql string, start int, name *ast.ColumnName) int {
+	var parts []string
+	if name.Schema.L != "" {
+		parts = append(parts, name.Schema.L)
+	}
+	if name.Table.L != "" {
+		parts = append(parts, name.Table.L)
+	}
+	parts = append(parts, name.Name.L)
+	tokens := tokenizeSQL(sql)
+	inWhere := false
+	for i, token := range tokens {
+		if token.start < start {
+			continue
+		}
+		if token.wordIs(sql, "WHERE") {
+			inWhere = true
+			continue
+		}
+		if !inWhere || i > 0 && tokens[i-1].text(sql) == "." {
+			continue
+		}
+		j := i
+		matched := true
+		for partIndex, part := range parts {
+			if partIndex > 0 {
+				if j >= len(tokens) || tokens[j].text(sql) != "." {
+					matched = false
+					break
+				}
+				j++
+			}
+			if j >= len(tokens) || tokens[j].kind != tokWord && tokens[j].kind != tokQIdent ||
+				tokens[j].identText(sql) != part {
+				matched = false
+				break
+			}
+			j++
+		}
+		if matched {
+			return token.start
+		}
+	}
+	return -1
+}
+
+func ParseViewDefinition(ctx context.Context, sqlText string) (*spec.ViewDefinition, error) {
+	node, _, err := parseViewQuery(ctx, sqlText)
+	if err != nil {
+		return nil, err
+	}
+	return viewDefinition(node, sqlText, 0, 0, false), nil
+}
+
+func parseViewAdapter(ctx context.Context, sql string) (*viewStatement, []error, bool) {
+	header, ok := parseViewHeader(sql)
+	if !ok {
+		return nil, nil, false
+	}
+	query, warnings, err := parseViewQuery(ctx, sql[header.selectStart:header.selectEnd])
+	if err != nil {
+		return nil, nil, false
+	}
+	header.declaration.Definition = viewDefinition(query, sql, header.selectStart, header.selectStart, true)
+	query.SetText(charset.FindEncoding(""), strings.TrimSpace(sql))
+	query.SetOriginTextPosition(0)
+	return &viewStatement{StmtNode: query, operation: header.operation, target: header.target, declaration: header.declaration}, warnings, true
+}
