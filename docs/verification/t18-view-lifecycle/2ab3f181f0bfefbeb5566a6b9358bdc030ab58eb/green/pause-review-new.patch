+			config.WriteString("    params:\n      tables: [t18_private_hidden]\n")
+		}
+	}
+	if err := os.WriteFile(path, []byte(config.String()), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	sqlText := "CREATE VIEW next_v AS SELECT id FROM t;"
+	for _, tc := range []struct {
+		mode, coverage string
+		blockers       int
+		fact           string
+	}{
