+	if node.GroupBy != nil {
+		for _, item := range node.GroupBy.Items {
+			if item != nil && item.Expr != nil {
+				b.addExpression(query, item.Expr, scope, depth, -1, true)
+			}
+		}
+	}
+	if node.Having != nil && node.Having.Expr != nil {
+		b.addExpression(query, node.Having.Expr, scope, depth, -1, true)
+	}
+	if node.OrderBy != nil {
+		for _, item := range node.OrderBy.Items {
+			if item != nil && item.Expr != nil {
+				b.addExpression(query, item.Expr, scope, depth, -1, true)
+			}
+		}
+	}
