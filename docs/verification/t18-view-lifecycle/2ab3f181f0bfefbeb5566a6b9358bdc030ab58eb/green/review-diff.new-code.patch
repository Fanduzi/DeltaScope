+package audit
+
+import (
+	"context"
+	"strings"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+)
+
+type viewStateReadError struct{ cause error }
+
+func (viewStateReadError) Error() string   { return "view metadata read failed" }
+func (e viewStateReadError) Unwrap() error { return e.cause }
+
+func (s *batchState) projectViewMetadata(ctx context.Context, statement spec.Statement, target *spec.TableSnapshot, sources []*spec.TableSnapshot) (*spec.ViewMetadata, error) {
+	key := s.keyFor(s.schema, *statement.DDL.Table)
+	metadata := &spec.ViewMetadata{
+		TargetIdentity:      spec.Table{Schema: key.schema, Name: key.table},
+		Target:              target,
+		DependencyCycleRoot: -1,
+	}
+	definition := statement.DDL.View.Definition
+	if definition == nil {
+		return metadata, nil
+	}
+	for i, source := range definition.Sources {
+		sourceKey := s.keyFor(s.schema, source)
+		binding := spec.TargetBinding{Table: spec.Table{Schema: sourceKey.schema, Name: sourceKey.table}}
+		if i < len(sources) {
+			binding.Snapshot = sources[i]
+		}
+		metadata.Sources = append(metadata.Sources, binding)
+	}
+	seen := map[batchTableKey]struct{}{}
+	path := map[batchTableKey]bool{key: true}
+	var visit func(spec.TargetBinding, int, int) error
+	visit = func(binding spec.TargetBinding, depth, root int) error {
+		current := s.keyFor(s.schema, binding.Table)
+		if path[current] {
+			if !metadata.DependencyCycle {
+				metadata.DependencyCycleRoot = root
+			}
+			metadata.DependencyCycle = true
+			return nil
+		}
+		if _, exists := seen[current]; exists {
+			return nil
+		}
+		if depth > 32 || len(seen) >= 256 {
+			metadata.DependencyLimit = true
+			return nil
+		}
+		seen[current] = struct{}{}
+		snapshot := binding.Snapshot
+		if snapshot == nil || !snapshot.Exists || snapshot.RelationKind != "view" ||
+			snapshot.View == nil || snapshot.View.Definition == nil ||
+			!snapshot.View.Definition.SourcesKnown {
+			return nil
+		}
+		path[current] = true
+		defer delete(path, current)
+		for _, source := range snapshot.View.Definition.Sources {
+			if strings.TrimSpace(source.Schema) == "" {
+				metadata.DependencyUnproven = true
+				continue
+			}
+			ns, entry, sourceKey, err := s.bindSource(ctx, source)
+			if err != nil {
+				return err
+			}
+			dependency := s.projectBoundSnapshot(sourceKey, ns, entry)
+			dependency.Table = spec.Table{Schema: sourceKey.schema, Name: sourceKey.table}
+			metadata.Dependencies = append(metadata.Dependencies, dependency)
+			metadata.DependencyRoots = append(metadata.DependencyRoots, root)
+			if err := visit(dependency, depth+1, root); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	for i, source := range metadata.Sources {
+		if err := visit(source, 1, i); err != nil {
+			return nil, err
+		}
+	}
+	return metadata, nil
+}
+
+func (s *batchState) applyView(statement spec.Statement) error {
+	ddl := statement.DDL
+	if ddl == nil || ddl.View == nil || ddl.Table == nil || statement.Metadata == nil || statement.Metadata.View == nil {
+		return nil
+	}
+	assessment := spec.AssessViewLifecycle(statement)
+	if assessment.TargetInvalid || assessment.SourceInvalid {
+		return nil
+	}
+	key := s.keyFor(s.schema, *ddl.Table)
+	if len(assessment.TargetRequired) != 0 || len(assessment.SourceRequired) != 0 ||
+		assessment.DependencyLimit || len(ddl.UnextractedOptions) != 0 {
+		prior := statement.Metadata.View.Target
+		if ddl.Operation == spec.DDLOperationAlterView && prior != nil && prior.Exists && prior.RelationKind == "view" {
+			shape := cloneTableSnapshot(prior)
+			shape.Columns = nil
+			if shape.View != nil {
+				shape.View.Definition = nil
+				shape.View.Updatable = nil
+				if ddl.View.AlgorithmExplicit && ddl.View.Algorithm != "undefined" {
+					shape.View.Algorithm = ""
+				}
+				if ddl.View.DefinerKind != "" {
+					shape.View.DefinerKind = ""
+					shape.View.DefinerPrincipal = ""
+				}
+				if ddl.View.SecurityExplicit && shape.View.Security != ddl.View.Security {
+					shape.View.Security = ""
+				}
+				check := "none"
+				if ddl.View.CheckExplicit {
+					check = ddl.View.CheckOption
+				}
+				if shape.View.CheckOption != check {
+					shape.View.CheckOption = ""
+				}
+			}
+			s.entries[key] = &batchTableEntry{state: tablePresent, shape: shape, displaySchema: prior.Schema, displayTable: ddl.Table.Name}
+		} else {
+			s.invalidateKey(key)
+		}
+		return nil
+	}
+	var shape *spec.TableSnapshot
+	if ddl.Operation == spec.DDLOperationAlterView {
+		shape = cloneTableSnapshot(statement.Metadata.View.Target)
+	} else {
+		shape = &spec.TableSnapshot{
+			Schema: key.schema, Table: &spec.Table{Schema: key.schema, Name: key.table},
+			Exists: true, RelationKind: "view",
+		}
+	}
+	if shape.View == nil {
+		shape.View = &spec.ViewSnapshot{}
+	}
+	definition := spec.CloneViewDefinition(ddl.View.Definition)
+	for i := range definition.Sources {
+		definition.Sources[i] = statement.Metadata.View.Sources[i].Table
+	}
+	shape.View.Definition = definition
+	shape.View.Security = assessment.Security
+	shape.View.CheckOption = "none"
+	shape.View.Updatable = nil
+	shape.Columns = nil
+	if definition.ShapeKnown && len(statement.Metadata.View.Sources) == 1 {
+		source := statement.Metadata.View.Sources[0].Snapshot
+		shape.Columns = make([]spec.Column, 0, len(definition.Bindings))
+		for _, binding := range definition.Bindings {
+			for _, column := range source.Columns {
+				if strings.EqualFold(column.Name, binding.Column) {
+					derived := cloneColumn(column)
+					derived.Name = binding.Output
+					shape.Columns = append(shape.Columns, derived)
+					break
+				}
+			}
+		}
+	}
+	s.entries[key] = &batchTableEntry{state: tablePresent, shape: shape, displaySchema: key.schema, displayTable: key.table}
+	return nil
+}
diff --git a/internal/domain/rule/ddl/view_lifecycle_rules.go b/internal/domain/rule/ddl/view_lifecycle_rules.go
new file mode 100644
index 00000000..872c442e
--- /dev/null
+++ b/internal/domain/rule/ddl/view_lifecycle_rules.go
@@ -0,0 +1,140 @@
+package ddl
+
+import (
+	"context"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/policy"
+	"github.com/Fanduzi/DeltaScope/internal/domain/rule"
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+)
+
+type viewLifecycleRule struct {
+	ruleID string
+	level  rule.Level
+}
+
+func newViewLifecycleRule(id string, fallback rule.Level, cfg policy.RulePolicy) rule.StatementRule {
+	return viewLifecycleRule{ruleID: id, level: configuredLevel(cfg, fallback)}
+}
+
+func (r viewLifecycleRule) ID() string { return r.ruleID }
+
+func (r viewLifecycleRule) AppliesTo(statement spec.Statement) bool {
+	if r.ruleID != "ddl.view.target.valid" && r.ruleID != "ddl.view.source.valid" &&
+		r.ruleID != "ddl.view.security.definer.warn" {
+		return false
+	}
+	return orderedGapDialect(statement.Dialect) && statement.Kind == spec.KindDDL &&
+		statement.DDL != nil && statement.DDL.View != nil && statement.Unsupported == nil &&
+		(statement.DDL.Operation == spec.DDLOperationCreateView || statement.DDL.Operation == spec.DDLOperationAlterView)
+}
+
+func (r viewLifecycleRule) Evaluate(ctx context.Context, statement spec.Statement) ([]rule.Finding, error) {
+	if !r.AppliesTo(statement) {
+		return nil, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	assessment := spec.AssessViewLifecycle(statement)
+	var message, suggestion, role string
+	switch r.ruleID {
+	case "ddl.view.target.valid":
+		if assessment.TargetInvalid {
+			message = "view target is invalid for this operation"
+			suggestion = "check the target relation and operation"
+			role = "target"
+		}
+	case "ddl.view.source.valid":
+		if assessment.SourceInvalid {
+			message = "view definition has an invalid source"
+			suggestion = "check the authored source relations and columns"
+			role = "source"
+		}
+	case "ddl.view.security.definer.warn":
+		if assessment.Security == "definer" || assessment.ReviewPrincipal {
+			message = "view security or named definer requires review"
+			suggestion = "review the view's privilege context"
+			role = "view"
+		}
+	}
+	if message == "" {
+		return nil, nil
+	}
+	finding := rule.Finding{
+		RuleID: r.ruleID, Level: r.level, Message: message, Suggestion: suggestion,
+		Metadata: viewFindingMetadata(statement, assessment, role),
+	}
+	if role == "source" {
+		finding.Location = viewSourceLocation(statement, assessment)
+	}
+	return []rule.Finding{finding}, nil
+}
+
+func viewFindingMetadata(statement spec.Statement, assessment spec.ViewLifecycleAssessment, role string) map[string]any {
+	var target spec.Table
+	if statement.DDL.Table != nil {
+		target = *statement.DDL.Table
+	}
+	if statement.Metadata != nil && statement.Metadata.View != nil {
+		target = statement.Metadata.View.TargetIdentity
+	}
+	metadata := map[string]any{"role": role, "view": target.Name, "view_schema": target.Schema}
+	if role == "source" && assessment.SourceRootIndex >= 0 &&
+		statement.Metadata != nil && statement.Metadata.View != nil &&
+		assessment.SourceRootIndex < len(statement.Metadata.View.Sources) {
+		source := statement.Metadata.View.Sources[assessment.SourceRootIndex].Table
+		metadata["schema"] = source.Schema
+		metadata["table"] = source.Name
+	}
+	return metadata
+}
+
+func viewSourceLocation(statement spec.Statement, assessment spec.ViewLifecycleAssessment) *rule.Location {
+	if statement.Line <= 0 || statement.Column <= 0 || statement.DDL.View.Definition == nil {
+		return nil
+	}
+	definition := statement.DDL.View.Definition
+	offset := -1
+	if assessment.SourceBindingIndex >= 0 && assessment.SourceBindingIndex < len(definition.Bindings) {
+		offset = definition.Bindings[assessment.SourceBindingIndex].Offset
+	}
+	if offset < 0 && assessment.SourceRootIndex >= 0 && assessment.SourceRootIndex < len(definition.SourceOffsets) {
+		offset = definition.SourceOffsets[assessment.SourceRootIndex]
+	}
+	if offset < 0 || offset > len(statement.RawSQL) {
+		return nil
+	}
+	location := &rule.Location{Line: statement.Line, Column: statement.Column}
+	for _, r := range statement.RawSQL[:offset] {
+		if r == '\n' {
+			location.Line++
+			location.Column = 1
+		} else {
+			location.Column++
+		}
+	}
+	return location
+}
+
+func (r viewLifecycleRule) EvidenceGaps(statement spec.Statement) []rule.EvidenceGap {
+	if !r.AppliesTo(statement) {
+		return nil
+	}
+	assessment := spec.AssessViewLifecycle(statement)
+	var facts []string
+	switch r.ruleID {
+	case "ddl.view.target.valid":
+		facts = assessment.TargetRequired
+	case "ddl.view.source.valid":
+		facts = assessment.SourceRequired
+	case "ddl.view.security.definer.warn":
+		if assessment.SecurityUnknown {
+			facts = []string{"view.security"}
+		}
+	}
+	if len(facts) == 0 {
+		return nil
+	}
+	return []rule.EvidenceGap{{ReasonCode: gapReasonUnknownTableState, RequiredFacts: facts}}
+}
diff --git a/internal/domain/spec/view.go b/internal/domain/spec/view.go
new file mode 100644
index 00000000..0fb02009
--- /dev/null
+++ b/internal/domain/spec/view.go
@@ -0,0 +1,253 @@
+package spec
+
+import "strings"
+
+type ViewDeclaration struct {
+	OrReplace         bool
+	Columns           []string
+	Algorithm         string
+	AlgorithmExplicit bool
+	Security          string
+	SecurityExplicit  bool
+	CheckOption       string
+	CheckExplicit     bool
+	CheckBare         bool
+	DefinerKind       string
+	DefinerPrincipal  string `json:"-"`
+	Definition        *ViewDefinition
+}
+
+type ViewDefinition struct {
+	SQL           string `json:"-"`
+	Sources       []Table
+	SourceAliases []string
+	SourceOffsets []int `json:"-"`
+	SourcesKnown  bool
+	Bindings      []ViewColumnBinding
+	ShapeKnown    bool
+}
+
+type ViewColumnBinding struct {
+	Schema string
+	Table  string
+	Column string
+	Output string
+	Offset int `json:"-"`
+}
+
+type ViewSnapshot struct {
+	Definition       *ViewDefinition
+	Algorithm        string
+	Security         string
+	CheckOption      string
+	Updatable        *bool
+	DefinerKind      string
+	DefinerPrincipal string `json:"-"`
+}
+
+type ViewMetadata struct {
+	TargetIdentity      Table
+	Target              *TableSnapshot
+	Sources             []TargetBinding
+	Dependencies        []TargetBinding
+	DependencyRoots     []int
+	DependencyCycle     bool
+	DependencyCycleRoot int
+	DependencyUnproven  bool
+	DependencyLimit     bool
+}
+
+type ViewLifecycleAssessment struct {
+	TargetInvalid      bool
+	SourceInvalid      bool
+	SourceRootIndex    int
+	SourceBindingIndex int
+	TargetRequired     []string
+	SourceRequired     []string
+	Security           string
+	SecurityUnknown    bool
+	ReviewPrincipal    bool
+	DependencyLimit    bool
+}
+
+func appendViewFact(facts []string, fact string) []string {
+	for _, existing := range facts {
+		if existing == fact {
+			return facts
+		}
+	}
+	return append(facts, fact)
+}
+
+func sameViewIdentity(a, b Table) bool {
+	return strings.EqualFold(a.Schema, b.Schema) && strings.EqualFold(a.Name, b.Name)
+}
+
+func AssessViewLifecycle(statement Statement) ViewLifecycleAssessment {
+	assessment := ViewLifecycleAssessment{SourceRootIndex: -1, SourceBindingIndex: -1}
+	if statement.DDL == nil || statement.DDL.View == nil {
+		return assessment
+	}
+	ddl := statement.DDL
+	assessment.ReviewPrincipal = ddl.View.DefinerKind == "named"
+	var metadata *ViewMetadata
+	if statement.Metadata != nil {
+		metadata = statement.Metadata.View
+	}
+	if metadata == nil {
+		assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "table.exists")
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "table.exists")
+		assessment.SecurityUnknown = true
+		return assessment
+	}
+	switch {
+	case metadata.Target == nil:
+		assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "table.exists")
+	case ddl.Operation == DDLOperationAlterView && !metadata.Target.Exists:
+		assessment.TargetInvalid = true
+	case ddl.Operation == DDLOperationCreateView && metadata.Target.Exists && !ddl.View.OrReplace:
+		assessment.TargetInvalid = true
+	case metadata.Target.Exists && metadata.Target.RelationKind == "":
+		assessment.TargetRequired = appendViewFact(assessment.TargetRequired, "relation.kind")
+	case ddl.Operation == DDLOperationAlterView && metadata.Target.RelationKind != "view":
+		assessment.TargetInvalid = true
+	case ddl.Operation == DDLOperationCreateView && metadata.Target.Exists &&
+		(!ddl.View.OrReplace || metadata.Target.RelationKind != "view"):
+		assessment.TargetInvalid = true
+	}
+	if ddl.View.SecurityExplicit {
+		assessment.Security = ddl.View.Security
+	} else if ddl.Operation == DDLOperationCreateView && statement.Dialect == DialectMySQL {
+		assessment.Security = "definer"
+	} else if metadata.Target != nil && metadata.Target.View != nil {
+		assessment.Security = metadata.Target.View.Security
+	}
+	assessment.SecurityUnknown = assessment.Security == ""
+	definition := ddl.View.Definition
+	if definition == nil || !definition.SourcesKnown {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+	} else if len(metadata.Sources) != len(definition.Sources) {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+	}
+	markSourceInvalid := func(root, binding int) {
+		if !assessment.SourceInvalid {
+			assessment.SourceRootIndex = root
+			assessment.SourceBindingIndex = binding
+		}
+		assessment.SourceInvalid = true
+	}
+	if metadata.DependencyCycle {
+		markSourceInvalid(metadata.DependencyCycleRoot, -1)
+	}
+	if metadata.DependencyUnproven {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+	}
+	assessment.DependencyLimit = metadata.DependencyLimit
+	all := make([]TargetBinding, 0, len(metadata.Sources)+len(metadata.Dependencies))
+	all = append(all, metadata.Sources...)
+	all = append(all, metadata.Dependencies...)
+	for i, source := range all {
+		root := i
+		if i >= len(metadata.Sources) {
+			dependency := i - len(metadata.Sources)
+			root = -1
+			if dependency < len(metadata.DependencyRoots) {
+				root = metadata.DependencyRoots[dependency]
+			}
+		}
+		if sameViewIdentity(source.Table, metadata.TargetIdentity) {
+			markSourceInvalid(root, -1)
+			continue
+		}
+		switch {
+		case source.Snapshot == nil:
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "table.exists")
+		case !source.Snapshot.Exists || source.Snapshot.Temporary:
+			markSourceInvalid(root, -1)
+		case source.Snapshot.RelationKind == "":
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "relation.kind")
+		case source.Snapshot.RelationKind == "view" && (source.Snapshot.View == nil || source.Snapshot.View.Definition == nil):
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.definition")
+		case source.Snapshot.RelationKind == "view" && !source.Snapshot.View.Definition.SourcesKnown:
+			assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.dependencies")
+		}
+	}
+	if definition != nil && !definition.ShapeKnown && !(len(metadata.Sources) == 1 &&
+		metadata.Sources[0].Snapshot != nil &&
+		(!metadata.Sources[0].Snapshot.Exists || metadata.Sources[0].Snapshot.Temporary)) {
+		assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.columns")
+	}
+	if definition != nil && definition.ShapeKnown && len(metadata.Sources) == 1 {
+		identity := metadata.Sources[0].Table
+		qualifier := identity.Name
+		if len(definition.SourceAliases) > 0 && definition.SourceAliases[0] != "" {
+			qualifier = definition.SourceAliases[0]
+		}
+		invalidQualifier := make([]bool, len(definition.Bindings))
+		for i, binding := range definition.Bindings {
+			if binding.Table != "" && !strings.EqualFold(binding.Table, qualifier) ||
+				binding.Schema != "" && !strings.EqualFold(binding.Schema, identity.Schema) {
+				invalidQualifier[i] = true
+				markSourceInvalid(0, i)
+			}
+		}
+		source := metadata.Sources[0].Snapshot
+		if source != nil && source.Exists && !source.Temporary {
+			if source.Columns == nil {
+				for _, invalid := range invalidQualifier {
+					if !invalid {
+						assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.columns")
+						break
+					}
+				}
+			} else {
+				for i, binding := range definition.Bindings {
+					if invalidQualifier[i] {
+						continue
+					}
+					if !source.HasColumn(binding.Column) {
+						if source.ColumnsTailUnknown {
+							assessment.SourceRequired = appendViewFact(assessment.SourceRequired, "view.columns")
+						} else {
+							markSourceInvalid(0, i)
+						}
+					}
+				}
+			}
+		}
+	}
+	return assessment
+}
+
+func CloneViewDefinition(in *ViewDefinition) *ViewDefinition {
+	if in == nil {
+		return nil
+	}
+	out := *in
+	if in.Sources != nil {
+		out.Sources = append([]Table{}, in.Sources...)
+	}
+	if in.SourceAliases != nil {
+		out.SourceAliases = append([]string{}, in.SourceAliases...)
+	}
+	if in.SourceOffsets != nil {
+		out.SourceOffsets = append([]int{}, in.SourceOffsets...)
+	}
+	if in.Bindings != nil {
+		out.Bindings = append([]ViewColumnBinding{}, in.Bindings...)
+	}
+	return &out
+}
+
+func CloneViewSnapshot(in *ViewSnapshot) *ViewSnapshot {
+	if in == nil {
+		return nil
+	}
+	out := *in
+	out.Definition = CloneViewDefinition(in.Definition)
+	if in.Updatable != nil {
+		value := *in.Updatable
+		out.Updatable = &value
+	}
+	return &out
+}
diff --git a/internal/infrastructure/metadata/mysql/provider_t18_first_test.go b/internal/infrastructure/metadata/mysql/provider_t18_first_test.go
new file mode 100644
index 00000000..d090f207
--- /dev/null
+++ b/internal/infrastructure/metadata/mysql/provider_t18_first_test.go
@@ -0,0 +1,88 @@
+package mysqlmeta
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+)
+
+func t18ViewRows(view testQueryResult) map[string]testQueryResult {
+	return map[string]testQueryResult{
+		"from information_schema.tables": {
+			columns: []string{"engine", "table_collation", "table_comment", "auto_increment", "row_format", "table_rows", "table_type"},
+			rows:    [][]driver.Value{{nil, nil, "VIEW", nil, nil, nil, "VIEW"}},
+		},
+		"from information_schema.columns": {
+			columns: []string{"column_name", "column_type", "character_set_name", "collation_name", "column_comment", "column_default", "is_nullable", "extra", "generation_expression"},
+			rows:    [][]driver.Value{{"id", "int", nil, nil, "", nil, "YES", "", ""}},
+		},
+		"from information_schema.views": view,
+	}
+}
+
+func TestT18FirstViewCatalogFacts(t *testing.T) {
+	rows := testQueryResult{
+		columns: []string{"view_definition", "security_type", "check_option", "is_updatable", "definer"},
+		rows:    [][]driver.Value{{"SELECT `g`.`u`.`id` AS `id` FROM `g`.`u`", "DEFINER", "NONE", "YES", "t18_private_principal@host"}},
+	}
+	snapshot, err := NewProvider(openTestDB(t, t18ViewRows(rows))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if err != nil || snapshot == nil || !snapshot.Exists || snapshot.RelationKind != "view" || snapshot.View == nil ||
+		snapshot.View.Security != "definer" || snapshot.View.CheckOption != "none" ||
+		snapshot.View.Updatable == nil || !*snapshot.View.Updatable || snapshot.View.Definition == nil ||
+		!snapshot.View.Definition.SourcesKnown || len(snapshot.View.Definition.Sources) != 1 ||
+		snapshot.View.Definition.Sources[0] != (spec.Table{Schema: "g", Name: "u"}) {
+		t.Fatalf("snapshot=%#v err=%v", snapshot, err)
+	}
+	encoded, err := json.Marshal(snapshot)
+	if err != nil || strings.Contains(string(encoded), "t18_private_principal") || strings.Contains(string(encoded), "SELECT") {
+		t.Fatalf("snapshot JSON=%s err=%v", encoded, err)
+	}
+}
+
+func TestT18FirstViewCatalogNullAndError(t *testing.T) {
+	row := testQueryResult{
+		columns: []string{"view_definition", "security_type", "check_option", "is_updatable", "definer"},
+		rows:    [][]driver.Value{{nil, "DEFINER", "NONE", nil, nil}},
+	}
+	snapshot, err := NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if err != nil || snapshot == nil || !snapshot.Exists || snapshot.View == nil || snapshot.View.Definition != nil {
+		t.Fatalf("snapshot=%#v err=%v", snapshot, err)
+	}
+	row.rows = nil
+	snapshot, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if err != nil || snapshot == nil || !snapshot.Exists || snapshot.RelationKind != "view" ||
+		snapshot.View == nil || snapshot.View.Definition != nil {
+		t.Fatalf("missing attributes must remain unknown: snapshot=%#v err=%v", snapshot, err)
+	}
+	cause := errors.New("t18_private_driver_error")
+	row = testQueryResult{queryErr: cause}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, cause) || strings.Contains(err.Error(), "t18_private_driver_error") {
+		t.Fatalf("unbounded or lost error: %v", err)
+	}
+	row = testQueryResult{queryErr: sql.ErrNoRows}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, sql.ErrNoRows) {
+		t.Fatalf("driver error was treated as an empty result: %v", err)
+	}
+	row = testQueryResult{
+		columns:  []string{"view_definition", "security_type", "check_option", "is_updatable", "definer"},
+		rows:     [][]driver.Value{{"SELECT id FROM t", "DEFINER", "NONE", "YES", "private"}},
+		rowErrAt: 1, rowErr: cause,
+	}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, cause) || strings.Contains(err.Error(), "t18_private_driver_error") {
+		t.Fatalf("unbounded or lost iteration error: %v", err)
+	}
+	row = testQueryResult{queryErr: context.DeadlineExceeded}
+	_, err = NewProvider(openTestDB(t, t18ViewRows(row))).LoadTableSnapshot(context.Background(), spec.DialectMySQL, "g", "v")
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("provider timeout was lost: %v", err)
+	}
+}
diff --git a/internal/infrastructure/parser/tidb/view.go b/internal/infrastructure/parser/tidb/view.go
new file mode 100644
index 00000000..6000c8f5
--- /dev/null
+++ b/internal/infrastructure/parser/tidb/view.go
@@ -0,0 +1,390 @@
+package tidbparser
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/Fanduzi/DeltaScope/internal/domain/spec"
+	"github.com/pingcap/tidb/pkg/parser"
+	"github.com/pingcap/tidb/pkg/parser/ast"
+	"github.com/pingcap/tidb/pkg/parser/charset"
+	"github.com/pingcap/tidb/pkg/parser/format"
+)
+
+type viewStatement struct {
+	ast.StmtNode
+	operation   spec.DDLOperation
+	target      spec.Table
+	declaration *spec.ViewDeclaration
+}
+
+type viewHeader struct {
+	operation   spec.DDLOperation
+	target      spec.Table
+	declaration *spec.ViewDeclaration
+	selectStart int
+	selectEnd   int
+}
+
+func unmodeledViewOptions(view *spec.ViewDeclaration) []string {
+	var options []string
+	if view.OrReplace {
+		options = append(options, "or_replace")
+	}
+	if len(view.Columns) > 0 {
+		options = append(options, "view_columns")
+	}
+	if view.AlgorithmExplicit {
+		options = append(options, "view_algorithm")
+	}
+	if view.DefinerKind != "" {
+		options = append(options, "definer")
+	}
+	if view.SecurityExplicit {
+		options = append(options, "sql_security")
+	}
+	if view.CheckExplicit {
+		options = append(options, "check_option")
+	}
+	if view.Definition == nil || !view.Definition.ShapeKnown || !view.Definition.SourcesKnown {
+		options = append(options, "view_query_shape")
+	}
+	return options
+}
+
+func parseViewIdentifier(text string, components int) (string, string, bool) {
+	nodes, _, err := parser.New().Parse("SELECT "+text, "", "")
+	if err != nil || len(nodes) != 1 {
+		return "", "", false
+	}
+	query, ok := nodes[0].(*ast.SelectStmt)
+	if !ok || query.Fields == nil || len(query.Fields.Fields) != 1 || query.From != nil {
+		return "", "", false
+	}
+	field := query.Fields.Fields[0]
+	column, ok := field.Expr.(*ast.ColumnNameExpr)
+	if !ok || column.Name == nil || field.AsName.L != "" || column.Name.Schema.L != "" || column.Name.Name.L == "" {
+		return "", "", false
+	}
+	if components == 1 && column.Name.Table.L == "" {
+		return "", column.Name.Name.L, true
+	}
+	if components == 2 && column.Name.Table.L != "" {
+		return column.Name.Table.L, column.Name.Name.L, true
+	}
+	return "", "", false
+}
+
+func parseViewHeader(sql string) (*viewHeader, bool) {
+	tokens := tokenizeSQL(sql)
+	if len(tokens) < 5 {
+		return nil, false
+	}
+	i := 0
+	take := func(word string) bool {
+		if i < len(tokens) && tokens[i].wordIs(sql, word) {
+			i++
+			return true
+		}
+		return false
+	}
+	punct := func(value string) bool {
+		if i < len(tokens) && tokens[i].kind == tokPunct && tokens[i].text(sql) == value {
+			i++
+			return true
+		}
+		return false
+	}
+	identifierToken := func() (sqlTok, bool) {
+		if i >= len(tokens) || (tokens[i].kind != tokWord && tokens[i].kind != tokQIdent) {
+			return sqlTok{}, false
+		}
+		token := tokens[i]
+		raw := token.text(sql)
+		if token.kind == tokQIdent && (len(raw) < 2 || raw[len(raw)-1] != '`') {
+			return sqlTok{}, false
+		}
+		i++
+		return token, true
+	}
+	h := &viewHeader{declaration: &spec.ViewDeclaration{}}
+	switch {
+	case take("ALTER"):
+		h.operation = spec.DDLOperationAlterView
+	case take("CREATE"):
+		h.operation = spec.DDLOperationCreateView
+		if take("OR") {
+			if !take("REPLACE") {
+				return nil, false
+			}
+			h.declaration.OrReplace = true
+		}
+	default:
+		return nil, false
+	}
+	if take("ALGORITHM") {
+		if !punct("=") {
+			return nil, false
+		}
+		switch {
+		case take("UNDEFINED"):
+			h.declaration.Algorithm = "undefined"
+		case take("MERGE"):
+			h.declaration.Algorithm = "merge"
+		case take("TEMPTABLE"):
+			h.declaration.Algorithm = "temptable"
+		default:
+			return nil, false
+		}
+		h.declaration.AlgorithmExplicit = true
+	}
+	if take("DEFINER") {
+		if !punct("=") || i >= len(tokens) {
+			return nil, false
+		}
+		if take("CURRENT_USER") {
+			h.declaration.DefinerKind = "current_user"
+			if punct("(") && !punct(")") {
+				return nil, false
+			}
+		} else {
+			start := tokens[i].start
+			if tokens[i].kind != tokWord && tokens[i].kind != tokQIdent && tokens[i].kind != tokStr {
+				return nil, false
+			}
+			end := tokens[i].end
+			i++
+			if punct("@") {
+				if i >= len(tokens) || (tokens[i].kind != tokWord && tokens[i].kind != tokQIdent && tokens[i].kind != tokStr) {
+					return nil, false
+				}
+				end = tokens[i].end
+				i++
+			}
+			h.declaration.DefinerKind = "named"
+			h.declaration.DefinerPrincipal = sql[start:end]
+		}
+	}
+	if take("SQL") {
+		if !take("SECURITY") {
+			return nil, false
+		}
+		switch {
+		case take("DEFINER"):
+			h.declaration.Security = "definer"
+		case take("INVOKER"):
+			h.declaration.Security = "invoker"
+		default:
+			return nil, false
+		}
+		h.declaration.SecurityExplicit = true
+	}
+	if !take("VIEW") {
+		return nil, false
+	}
+	first, valid := identifierToken()
+	if !valid {
+		return nil, false
+	}
+	if punct(".") {
+		second, ok := identifierToken()
+		if !ok {
+			return nil, false
+		}
+		h.target.Schema, h.target.Name, valid = parseViewIdentifier(sql[first.start:second.end], 2)
+	} else {
+		_, h.target.Name, valid = parseViewIdentifier(first.text(sql), 1)
+	}
+	if !valid {
+		return nil, false
+	}
+	if punct("(") {
+		for {
+			token, ok := identifierToken()
+			if !ok {
+				return nil, false
+			}
+			_, name, ok := parseViewIdentifier(token.text(sql), 1)
+			if !ok {
+				return nil, false
+			}
+			h.declaration.Columns = append(h.declaration.Columns, name)
+			if punct(")") {
+				break
+			}
+			if !punct(",") {
+				return nil, false
+			}
+		}
+	}
+	if !take("AS") || i >= len(tokens) {
+		return nil, false
+	}
+	h.selectStart = tokens[i].start
+	end := len(tokens)
+	if end > i && tokens[end-1].text(sql) == ";" {
+		end--
+	}
+	for j := i; j < end; j++ {
+		if tokens[j].kind == tokPunct && tokens[j].text(sql) == ";" {
+			return nil, false
+		}
+	}
+	if end <= i {
+		return nil, false
+	}
+	h.selectEnd = tokens[end-1].end
+	checkStart := end - 3
+	if end-i >= 3 && tokens[end-1].wordIs(sql, "OPTION") && tokens[end-2].wordIs(sql, "CHECK") {
+		if checkStart > i && (tokens[checkStart].wordIs(sql, "LOCAL") || tokens[checkStart].wordIs(sql, "CASCADED")) {
+			h.declaration.CheckOption = strings.ToLower(tokens[checkStart].text(sql))
+			checkStart--
+		} else {
+			h.declaration.CheckOption = "cascaded"
+			h.declaration.CheckBare = true
+		}
+		if checkStart <= i || !tokens[checkStart].wordIs(sql, "WITH") {
+			return nil, false
+		}
+		h.declaration.CheckExplicit = true
+		h.selectEnd = tokens[checkStart].start
+	}
+	return h, true
+}
+
+func parseViewQuery(ctx context.Context, sql string) (ast.StmtNode, []error, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, nil, err
+	}
+	nodes, warnings, err := parser.New().Parse(sql, "", "")
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(nodes) != 1 {
+		return nil, nil, fmt.Errorf("view definition must contain one query")
+	}
+	if _, ok := nodes[0].(ast.ResultSetNode); !ok {
+		return nil, nil, fmt.Errorf("view definition is not a query")
+	}
+	if selectNode, ok := nodes[0].(*ast.SelectStmt); ok && selectNode.SelectIntoOpt != nil {
+		return nil, nil, fmt.Errorf("view definition is not a query")
+	}
+	return nodes[0], warnings, nil
+}
+
+func viewDefinition(node ast.StmtNode, sql string, selectStart, offsetBase int, locations bool) *spec.ViewDefinition {
+	query, ok := node.(ast.ResultSetNode)
+	if !ok {
+		return nil
+	}
+	facts := analyzeQueryNode(query, newScopeStack(""))
+	ctes := make(map[string]bool)
+	for _, relation := range facts.relations {
+		if relation.Kind == "cte" {
+			ctes[strings.ToLower(relation.Name)] = true
+		}
+	}
+	definition := &spec.ViewDefinition{SourcesKnown: len(ctes) == 0}
+	for _, source := range selectSourceTables(query) {
+		if source.Schema == "" && ctes[strings.ToLower(source.Name)] {
+			continue
+		}
+		definition.Sources = append(definition.Sources, source)
+	}
+	definition.SourceAliases = make([]string, len(definition.Sources))
+	if locations {
+		definition.SourceOffsets = make([]int, len(definition.Sources))
+		for i := range definition.SourceOffsets {
+			definition.SourceOffsets[i] = -1
+		}
+	}
+	var restored strings.Builder
+	if err := node.Restore(format.NewRestoreCtx(format.DefaultRestoreFlags, &restored)); err == nil {
+		definition.SQL = restored.String()
+	}
+	selectNode, ok := node.(*ast.SelectStmt)
+	if !ok || selectNode.Fields == nil || selectNode.From == nil ||
+		selectNode.From.TableRefs == nil || selectNode.From.TableRefs.Right != nil {
+		return definition
+	}
+	source, ok := selectNode.From.TableRefs.Left.(*ast.TableSource)
+	if !ok {
+		return definition
+	}
+	if _, ok := source.Source.(*ast.TableName); !ok {
+		return definition
+	}
+	if len(definition.Sources) == 1 {
+		definition.SourceAliases[0] = source.AsName.L
+		if locations {
+			tokens := tokenizeSQL(sql)
+			depth := 0
+			for i, token := range tokens {
+				if token.start < selectStart {
+					continue
+				}
+				switch token.text(sql) {
+				case "(":
+					depth++
+				case ")":
+					depth--
+				}
+				if depth == 0 && token.wordIs(sql, "FROM") && i+1 < len(tokens) {
+					definition.SourceOffsets[0] = tokens[i+1].start
+					break
+				}
+			}
+		}
+	}
+	if selectNode.With != nil || selectNode.Where != nil || selectNode.GroupBy != nil ||
+		selectNode.Having != nil || selectNode.LockInfo != nil || selectNode.SelectIntoOpt != nil ||
+		selectNode.Distinct || len(selectNode.WindowSpecs) != 0 {
+		return definition
+	}
+	definition.ShapeKnown = true
+	for _, field := range selectNode.Fields.Fields {
+		column, ok := field.Expr.(*ast.ColumnNameExpr)
+		if !ok || column.Name == nil {
+			definition.ShapeKnown = false
+			definition.Bindings = nil
+			break
+		}
+		output := field.AsName.L
+		if output == "" {
+			output = column.Name.Name.L
+		}
+		offset := -1
+		if locations && field.Offset >= 0 && offsetBase+field.Offset < len(sql) {
+			offset = offsetBase + field.Offset
+		}
+		definition.Bindings = append(definition.Bindings, spec.ViewColumnBinding{
+			Schema: column.Name.Schema.L, Table: column.Name.Table.L,
+			Column: column.Name.Name.L, Output: output, Offset: offset,
+		})
+	}
+	return definition
+}
+
+func ParseViewDefinition(ctx context.Context, sqlText string) (*spec.ViewDefinition, error) {
+	node, _, err := parseViewQuery(ctx, sqlText)
+	if err != nil {
+		return nil, err
+	}
+	return viewDefinition(node, sqlText, 0, 0, false), nil
+}
+
+func parseViewAdapter(ctx context.Context, sql string) (*viewStatement, []error, bool) {
+	header, ok := parseViewHeader(sql)
+	if !ok {
+		return nil, nil, false
+	}
+	query, warnings, err := parseViewQuery(ctx, sql[header.selectStart:header.selectEnd])
+	if err != nil {
+		return nil, nil, false
+	}
+	header.declaration.Definition = viewDefinition(query, sql, header.selectStart, header.selectStart, true)
+	query.SetText(charset.FindEncoding(""), strings.TrimSpace(sql))
+	query.SetOriginTextPosition(0)
+	return &viewStatement{StmtNode: query, operation: header.operation, target: header.target, declaration: header.declaration}, warnings, true
+}
